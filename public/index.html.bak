        </button>
      </div>

      <!-- KHỐI 2: MỆNH LỆNH TẤN CÔNG BIÊN GIỚI (ATTACK FRONTLINE) -->
      <div class="card">
        <div class="card-label"><span>⚔️ 2. Công Phá Biên Giới (Chiếm Đất)</span></div>
        <div class="form-row">
          <select id="select-source-prov" onchange="updateTargetDropdown()"></select>
          <span style="align-self:center;font-weight:bold;color:#f87171;">➔</span>
          <select id="select-target-prov"></select>
        </div>
        <div class="btn-grid">
          <button class="btn-red" onclick="sendFrontlineAttack()">
