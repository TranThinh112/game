// Bounding Box của từng tỉnh phục vụ hiển thị mực máu từ trên xuống dưới
const PROVINCE_BOUNDS = {};
for(const [pid, rings] of Object.entries(VN_PROVINCE_POLYGONS)){
  let minLon = 999, maxLon = -999, minLat = 999, maxLat = -999;
  for(const ring of rings){
    for(const pt of ring){
      if(pt[0] < minLon) minLon = pt[0];
      if(pt[0] > maxLon) maxLon = pt[0];
      if(pt[1] < minLat) minLat = pt[1];
      if(pt[1] > maxLat) maxLat = pt[1];
    }
  }
  PROVINCE_BOUNDS[pid] = { minLon, maxLon, minLat, maxLat };
}

// Hàm xử lý khi tỉnh bị đánh bại và chuyển quyền chiếm giữ
function showConquerBanner(srcProv, tgtProv, conquerorUser){
  const box = document.getElementById('conquer-banner-box');
  if(!box) return;

  const banner = document.createElement('div');
  banner.className = 'conquer-banner';
  banner.innerHTML = 
    '<div class="conquer-icon">🚩</div>' +
    '<div class="conquer-content">' +
      '<div class="conquer-title">' +
        '<span>CHIẾN BÁO THÔN TÍNH LÃNH THỔ</span>' +
        '<span style="color:#94a3b8;font-size:9px;">VỪA XẢY RA</span>' +
      '</div>' +
      '<div class="conquer-desc">' +
        '<span class="conquer-highlight-src">【' + srcProv.name + '】</span> đã đánh bại và chiếm trọn <span class="conquer-highlight-tgt">【' + tgtProv.name + '】</span>!' +
      '</div>' +
    '</div>';

  box.prepend(banner);

  setTimeout(function(){
    banner.style.animation = 'bannerSlideOut 0.4s forwards';
    setTimeout(function(){
      if(banner.parentNode) banner.parentNode.removeChild(banner);
    }, 400);
  }, 4500);

  while(box.children.length > 2){
    box.removeChild(box.lastChild);
  }
}

// Bảng màu rực rỡ phong phú (64 sắc thái khác biệt cao) để gán cho các tỉnh sau khi thôn tính
// ==================================================================
// HỆ THỐNG ÂM THANH CHIẾN TRƯỜNG & GIỌNG ĐỌC AI BÌNH LUẬN VIÊN (TIẾNG VIỆT)
// ==================================================================
// ==================================================================
// HỆ THỐNG NHẠC NỀN CHIẾN CA "HÀO KHÍ VIỆT NAM" KHÔNG LỜI
// Hỗ trợ cả Audio stream Beat không lời và Web Audio Synth chạy liên tục
// ==================================================================
let bgmAudioEl = null;

function initHaoKhiAudio(){
  if(!bgmAudioEl){
    bgmAudioEl = new Audio('https://commondatastorage.googleapis.com/codeskulptor-demos/riceracer_assets/music/race.ogg'); // High energy march
    bgmAudioEl.loop = true;
    bgmAudioEl.volume = 0.35;
  }
}

// ==================================================================
// HỆ THỐNG NHẠC NỀN CHIẾN CA "HÀO KHÍ VIỆT NAM" KHÔNG LỜI (EPIC MARCH BGM)
// Tự động tổng hợp bằng Web Audio API (Drums dồn dập, Bassline hào hùng, Giai điệu ngũ cung hào khí)
// Không phụ thuộc file ngoài, không lo đứt mạng, phát tức thì & mượt mà
// ==================================================================
let isMusicPlaying = false;
let bgmInterval = null;
let bgmStep = 0;

// Giai điệu Hào Khí Việt Nam (Âm giai ngũ cung Việt Nam C D F G A - Tráng ca lịch sử)
// Giai điệu hào sảng chuẩn khúc ca HÀO KHÍ VIỆT NAM (Điệp khúc: Việt Nam ơi, giống hồng bàng ngàn năm sáng soi...)
const MELODY_NOTES = [
  // Đoạn 1: Việt Nam ơi - Giống Hồng Bàng
  293.66, 349.23, 392.00, 440.00,  // D4, F4, G4, A4
  440.00, 523.25, 587.33, 523.25,  // A4, C5, D5, C5
  440.00, 392.00, 440.00, 349.23,  // A4, G4, A4, F4
  293.66, 349.23, 392.00, 293.66,  // D4, F4, G4, D4

  // Đoạn 2: Ngàn năm sáng soi - Vang danh non sông
  440.00, 523.25, 587.33, 659.25,  // A4, C5, D5, E5
  587.33, 523.25, 440.00, 523.25,  // D5, C5, A4, C5
  587.33, 698.46, 587.33, 523.25,  // D5, F5, D5, C5
  440.00, 392.00, 349.23, 293.66   // A4, G4, F4, D4
];

const BASS_NOTES = [
  146.83, 146.83, 174.61, 196.00,  // D3, D3, F3, G3
  220.00, 220.00, 261.63, 293.66,  // A3, A3, C4, D4
  220.00, 196.00, 174.61, 146.83,  // A3, G3, F3, D3
  196.00, 174.61, 146.83, 146.83   // G3, F3, D3, D3
];

// Hàm phát 1 nốt nhạc tổng hợp với âm sắc kèn đồng & sáo trúc cổ truyền
function playTone(freq, duration, type = 'sawtooth', volume = 0.08, detune = 0){
  if(!audioCtx || !isMusicPlaying) return;
  try {
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.type = type;
    osc.frequency.setValueAtTime(freq, now);
    if(detune) osc.detune.setValueAtTime(detune, now);

    // Filter làm ấm âm sắc
    const filter = audioCtx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(freq * 3, now);

    gain.gain.setValueAtTime(0.001, now);
    gain.gain.linearRampToValueAtTime(volume * 1.5, now + 0.04);
    gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

    osc.connect(filter);
    filter.connect(gain);
    gain.connect(audioCtx.destination);

    osc.start(now);
    osc.stop(now + duration);
  } catch(e){}
}

// Tiếng trống trận dồn dập (War Drums & Cymbals)
function playWarDrum(isKick = true){
  if(!audioCtx || !isMusicPlaying) return;
  try {
    const now = audioCtx.currentTime;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    if(isKick){
      // Tiếng trống cái dồn dập
      osc.frequency.setValueAtTime(140, now);
      osc.frequency.exponentialRampToValueAtTime(35, now + 0.18);
      gain.gain.setValueAtTime(0.25, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.22);
    } else {
      // Tiếng chiêng trận / snare hào khí
      osc.type = 'triangle';
      osc.frequency.setValueAtTime(240, now);
      osc.frequency.exponentialRampToValueAtTime(70, now + 0.12);
      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
    }

    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.25);
  } catch(e){}
}

// Bắt đầu vòng lặp nhạc nền chiến ca
function startEpicBgm(){
  initAudioContext();
  if(bgmInterval) clearInterval(bgmInterval);
  isMusicPlaying = true;
  bgmStep = 0;

  // Tempo nhịp điệu hành quân hào hùng ~ 135 BPM (mỗi step 220ms)
  bgmInterval = setInterval(() => {
    if(!isMusicPlaying) return;

    // 1. Nhịp trống trận dồn dập
    if(bgmStep % 4 === 0){
      playWarDrum(true); // Nhịp trống cái
    } else if(bgmStep % 4 === 2){
      playWarDrum(false); // Nhịp trống con dồn
    } else {
      if(Math.random() < 0.4) playWarDrum(false);
    }

    // 2. Tiếng kèn đồng & sáo hào khí (Giai điệu Hào Khí Việt Nam)
    const melodyIdx = bgmStep % MELODY_NOTES.length;
    const freq = MELODY_NOTES[melodyIdx];
    playTone(freq, 0.35, 'sawtooth', 0.05, 4);  // Kèn đồng
    playTone(freq * 0.5, 0.4, 'triangle', 0.06); // Dây bè ấm

    // 3. Tiếng Bass trầm hùng
    const bassIdx = Math.floor(bgmStep / 2) % BASS_NOTES.length;
    playTone(BASS_NOTES[bassIdx], 0.38, 'sine', 0.12);

    bgmStep++;
  }, 220);

  const btn = document.getElementById('btn-music-toggle');
  if(btn){
    btn.innerText = '🎶';
    btn.style.borderColor = '#facc15';
    btn.style.boxShadow = '0 0 12px rgba(250, 204, 21, 0.6)';
    btn.title = 'Đang PHÁT Nhạc Nền Hào Khí Việt Nam (Click để Dừng)';
  }
}

function stopEpicBgm(){
  isMusicPlaying = false;
  if(bgmInterval){
    clearInterval(bgmInterval);
    bgmInterval = null;
  }
  const btn = document.getElementById('btn-music-toggle');
  if(btn){
    btn.innerText = '🔇';
    btn.style.borderColor = 'rgba(56, 189, 248, 0.35)';
    btn.style.boxShadow = 'none';
    btn.title = 'Đang TẮT Nhạc Nền (Click để Bật Hào Khí Việt Nam)';
  }
}

/* ------------------------------------------------------------------ */
/*    HỆ THỐNG NHẠC NỀN YOUTUBE (PLAYLIST NHẠC CÁCH MẠNG / CHIẾN CA REMIX) */
/* ------------------------------------------------------------------ */
let ytPlayer = null;
let isYtReady = false;
let isMusicPlaying = false;

// Tải YouTube IFrame Player API
(function loadYouTubeAPI(){
  const tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  const firstScriptTag = document.getElementsByTagName('script')[0];
  firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
})();

window.onYouTubeIframeAPIReady = function(){
  ytPlayer = new YT.Player('yt-bgm-player', {
    height: '1',
    width: '1',
    videoId: 'w1UBuEpstWE',
    playerVars: {
      'autoplay': 0,
      'controls': 0,
      'loop': 1,
      'playlist': 'w1UBuEpstWE',
      'start': 262
    },
    events: {
      'onReady': onPlayerReady,
      'onStateChange': onPlayerStateChange
    }
  });
};

function onPlayerReady(event){
  isYtReady = true;
  event.target.setVolume(70); // Âm lượng 70% vừa vặn để nghe rõ cả giọng đọc AI
}

function onPlayerStateChange(event){
  const btn = document.getElementById('btn-music-toggle');
  if(event.data === YT.PlayerState.PLAYING){
    isMusicPlaying = true;
    if(btn){
      btn.innerText = '🎶';
      btn.style.borderColor = '#facc15';
      btn.style.boxShadow = '0 0 12px rgba(250, 204, 21, 0.6)';
      btn.title = 'Đang PHÁT Nhạc Nền Remix Chiến Ca (Click để Dừng)';
    }
  } else if(event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED){
    isMusicPlaying = false;
    if(btn){
      btn.innerText = '🎵';
      btn.style.borderColor = 'rgba(56, 189, 248, 0.35)';
      btn.style.boxShadow = 'none';
      btn.title = 'Bật Nhạc Nền Remix Chiến Ca (Click để Bật)';
    }
  }
}

function toggleEpicBgm(){
  const btn = document.getElementById('btn-music-toggle');
  if(isYtReady && ytPlayer){
    if(isMusicPlaying){
      ytPlayer.pauseVideo();
      isMusicPlaying = false;
      if(btn){
        btn.innerText = '🎵';
        btn.style.borderColor = 'rgba(56, 189, 248, 0.35)';
        btn.style.boxShadow = 'none';
      }
    } else {
      ytPlayer.playVideo();
      isMusicPlaying = true;
      if(btn){
        btn.innerText = '🎶';
        btn.style.borderColor = '#facc15';
        btn.style.boxShadow = '0 0 12px rgba(250, 204, 21, 0.6)';
      }
    }
  } else {
    // Dự phòng khi mạng đang tải API
    if(btn){
      btn.innerText = '⏳';
      setTimeout(() => { if(btn) btn.innerText = '🎵'; }, 1500);
    }
  }
}

let isVoiceEnabled = true;
let audioCtx = null;
let viVoice = null;
let speechQueue = [];
let isSpeaking = false;

function initAudioContext(){
  if(!audioCtx){
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    if(AudioContext) audioCtx = new AudioContext();
  }
  if(audioCtx && audioCtx.state === 'suspended'){
    audioCtx.resume();
  }
}

// Tìm giọng tiếng Việt tối ưu trong hệ thống
function loadVoices(){
  if(!('speechSynthesis' in window)) return;
  const voices = window.speechSynthesis.getVoices();
  // Ưu tiên giọng tiếng Việt chuẩn (vi-VN)
  viVoice = voices.find(v => v.lang === 'vi-VN' || v.lang.startsWith('vi')) || null;
}
if('speechSynthesis' in window){
  window.speechSynthesis.onvoiceschanged = loadVoices;
  loadVoices();
}

// Hiệu ứng âm thanh tổng hợp (SFX Synthesizer) không cần file ngoài
function playSoundEffect(type){
  if(!isVoiceEnabled) return;
  initAudioContext();
  if(!audioCtx) return;

  const now = audioCtx.currentTime;
  if(type === 'conquer'){
    // Tiếng còi chiến thắng / fanfare hào hùng
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(440, now);
    osc.frequency.setValueAtTime(554.37, now + 0.1);
    osc.frequency.setValueAtTime(659.25, now + 0.2);
    osc.frequency.setValueAtTime(880, now + 0.3);
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.7);
  } else if(type === 'attack'){
    // Tiếng đại bác / laser xuất kích
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(320, now);
    osc.frequency.exponentialRampToValueAtTime(80, now + 0.2);
    gain.gain.setValueAtTime(0.2, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.25);
  }
}

// Hàng đợi phát giọng đọc AI để giọng nói trôi chảy, không bị đè nhau
let lastSpokenText = '';
let lastSpokenTime = 0;

function speakText(text, priority = false){
  if(!isVoiceEnabled) return;
  initAudioContext();

  const now = Date.now();
  // CHỐNG ĐỌC LẶP: Nếu câu này trùng với câu vừa phát trong vòng 4 giây -> BỎ QUA
  if(!priority && text === lastSpokenText && (now - lastSpokenTime < 4000)){
    return;
  }

  if(priority){
    if('speechSynthesis' in window) window.speechSynthesis.cancel();
    speechQueue = [];
    isSpeaking = false;
  }

  // Giữ hàng đợi tối đa 2 câu để luôn cập nhật diễn biến mới nhất, không bị delay
  if(speechQueue.length >= 2) return;
  if(speechQueue.includes(text)) return;

  speechQueue.push(text);

  if(!isSpeaking){
    processSpeechQueue();
  }
}

function processSpeechQueue(){
  if(speechQueue.length === 0){
    isSpeaking = false;
    return;
  }
  isSpeaking = true;
  const text = speechQueue.shift();
  lastSpokenText = text;
  lastSpokenTime = Date.now();

  // PHÁT ÂM TIẾNG VIỆT QUA PROXY NỘI BỘ VỚI TỐC ĐỘ 1.25x (NHANH, DỨT KHOÁT, KHÔNG CHẬM)
  try {
    const ttsUrl = '/api/tts?text=' + encodeURIComponent(text);
    const audio = new Audio(ttsUrl);
    audio.volume = 1.0;
    audio.playbackRate = 1.25; // Tăng tốc độ 1.25 lần
    
    audio.onended = function(){
      setTimeout(processSpeechQueue, 150);
    };
    audio.onerror = function(){
      tryLocalVietnameseVoice(text);
    };

    const playPromise = audio.play();
    if(playPromise !== undefined){
      playPromise.catch(function(){
        tryLocalVietnameseVoice(text);
      });
    }
  } catch(e){
    tryLocalVietnameseVoice(text);
  }
}

function tryLocalVietnameseVoice(text){
  if(!('speechSynthesis' in window)){
    setTimeout(processSpeechQueue, 300);
    return;
  }

  const voices = window.speechSynthesis.getVoices() || [];
  const trueViVoice = voices.find(v => (v.lang && (v.lang.toLowerCase().includes('vi') || v.lang.toLowerCase().includes('vie'))) || (v.name && v.name.toLowerCase().includes('vietnam')));

  if(!trueViVoice){
    // Tránh đọc giọng tiếng Anh
    setTimeout(processSpeechQueue, 300);
    return;
  }

  const utter = new SpeechSynthesisUtterance(text);
  utter.voice = trueViVoice;
  utter.lang = 'vi-VN';
  utter.rate = 1.25;

  utter.onend = function(){
    setTimeout(processSpeechQueue, 300);
  };
  utter.onerror = function(){
    setTimeout(processSpeechQueue, 200);
  };

  window.speechSynthesis.speak(utter);
}

// Biến lưu trữ người dẫn đầu trước đó để tránh đọc lặp
let lastLeaderId = null;
let lastLeaderAnnounceTime = 0;

// Bảng 9 màu chiến lược phân biệt cực cao
const CONQUEST_PALETTE = [
  '#e11d48', '#2563eb', '#16a34a', '#f59e0b', '#9333ea',
  '#06b6d4', '#f97316', '#ec4899', '#84cc16'
];

// ==================================================================
// CƠ CHẾ VÙNG AN TOÀN / HẬU PHƯƠNG BAO VÂY HOÀN TOÀN (ENCLAVE SANCTUARY)
// Nếu một tỉnh T (thuộc đế chế A) mà xung quanh đã được bao bọc kín
// bởi các lãnh thổ của đế chế A (không còn kề cận bất kỳ kẻ thù nào):
// => Lập tức được HỒI FULL 1000 HP và LẤP ĐẦY TOÀN BỘ 100% MÀU RỰC RỠ CỦA ĐẾ CHẾ A!
// ==================================================================

/* ------------------------------------------------------------------ */
/*    HỆ THỐNG THÔNG BÁO CHIẾN THẮNG & ANIMATION ĐẶC TRƯNG TỈNH THẮNG   */
/* ------------------------------------------------------------------ */
let isVictoryTriggered = false;
let victoryProvince = null;
let victoryAnimationStartTime = 0;

function checkUltimateVictory(winnerProv){
  if(isVictoryTriggered) return;
  const winnerEmpireId = winnerProv.ownerId || winnerProv.id;
  const conqueredTotal = provinces.filter(p => (p.ownerId || p.id) === winnerEmpireId).length;

  if(conqueredTotal >= 63 || (provinces.length > 0 && conqueredTotal === provinces.length)){
    triggerVictory(winnerProv);
  }
}

function triggerVictory(winnerProv){
  if(isVictoryTriggered) return;
  isVictoryTriggered = true;
  victoryProvince = winnerProv;
  victoryAnimationStartTime = Date.now();

  const winnerName = winnerProv.name;
  const winnerPlate = winnerProv.plate || '';
  const winnerColor = winnerProv.color || '#facc15';

  // Hiển thị Victory Modal
  const modal = document.getElementById('victory-modal');
  const nameEl = document.getElementById('victory-province-name');
  const badgeEl = document.getElementById('victory-province-badge');
  const descEl = document.getElementById('victory-desc');

  if(nameEl){
    nameEl.textContent = winnerName;
    nameEl.style.color = winnerColor;
    nameEl.style.textShadow = '0 0 20px ' + winnerColor;
  }
  if(badgeEl){
    badgeEl.textContent = 'BIỂN SỐ ' + winnerPlate;
    badgeEl.style.color = winnerColor;
    badgeEl.style.borderColor = winnerColor;
  }
  if(descEl){
    descEl.innerHTML = 'Chúc mừng <strong>' + winnerName + '</strong> đã xuất sắc bình định và thống nhất toàn bộ <strong>63 tỉnh thành Việt Nam</strong>!';
  }
  if(modal){
    modal.classList.add('active');
  }

  // Âm thanh chiến thắng & Giọng đọc AI chúc mừng chiến thắng (100% tiếng Việt, không chữ "đế chế")
  playSoundEffect('conquer');
  speakText('Chiến thắng tối cao! ' + winnerName + ' đã chính thức thống nhất toàn bộ 63 tỉnh thành Việt Nam! Vinh quang thuộc về ' + winnerName + '!', true);

  // Hiệu ứng pháo hoa rực rỡ toàn bản đồ
  launchVictoryFireworks(winnerColor);
}

function closeVictoryModal(){
  const modal = document.getElementById('victory-modal');
  if(modal) modal.classList.remove('active');
}

function launchVictoryFireworks(color){
  for(let i = 0; i < 30; i++){
    setTimeout(() => {
      if(!canvas) return;
      const rx = Math.random() * canvas.width;
      const ry = Math.random() * (canvas.height * 0.8) + 50;
      const randomCol = ['#facc15', '#38bdf8', '#ef4444', '#10b981', '#a855f7', color][Math.floor(Math.random() * 6)];
      effects.push({
        x: rx,
        y: ry,
        radius: 15,
        maxRadius: 85 + Math.random() * 45,
        color: randomCol,
        alpha: 1.0
      });
    }, i * 180);
  }
}

function checkAndHealEnclaves(){
  let healedAny = false;
  provinces.forEach(p => {
    const myEmpire = p.ownerId || p.id;
    const neighbors = VN_ADJACENCY[p.id] || [];

    if(neighbors.length > 0){
      // Kiểm tra xem tất cả các tỉnh giáp biên có cùng chung đế chế không
      const isSurroundedByAllies = neighbors.every(nid => {
        const np = provinces.find(pr => pr.id === nid);
        return np && (np.ownerId || np.id) === myEmpire;
      });

      if(isSurroundedByAllies){
        p.isEnclaveSafe = true;
        // Đảm bảo cùng màu tuyệt đối với tỉnh chủ quyền
        const empireMaster = provinces.find(pr => pr.id === myEmpire);
        if(empireMaster && p.color !== empireMaster.color){
          p.color = empireMaster.color;
        }
        // Hồi phục trọn vẹn 1000 HP
        if(p.hp !== undefined && p.hp < 1000){
          p.hp = 1000;
          healedAny = true;
        }
      } else {
        p.isEnclaveSafe = false;
      }
    }
  });
  return healedAny;
}

function onProvinceConquered(tgtProv, conquerorProv, conquerorUser){
  // 1. Kiểm tra cơ bản: Không thể tự chiếm chính mình
  if(!tgtProv || !conquerorProv || tgtProv.id === conquerorProv.id) return;

  // Xác định chủ quyền thực sự của bên tấn công (Đế chế C) và bên phòng thủ (Đế chế A)
  const conquerorEmpireId = conquerorProv.ownerId || conquerorProv.id;
  const formerEmpireId = tgtProv.ownerId || tgtProv.id;

  // 2. CHẶN TUYỆT ĐỐI: Cùng một đế chế thì không thể thôn tính nhau (chấm dứt lỗi 'Khánh Hòa thuộc Khánh Hòa', 'Vĩnh Long đánh bại Vĩnh Long')
  if(conquerorEmpireId === formerEmpireId) return;

  // Chống kích hoạt đúp khi nhiều lính cùng va chạm đích một lúc
  const now = Date.now();
  if(tgtProv._lastConqueredTime && (now - tgtProv._lastConqueredTime < 1500)) return;
  tgtProv._lastConqueredTime = now;

  const conquerorEmpireProv = provinces.find(p => p.id === conquerorEmpireId) || conquerorProv;
  const formerEmpireProv = provinces.find(p => p.id === formerEmpireId) || tgtProv;

  const formerEmpireName = formerEmpireProv.name;
  const conquerorEmpireName = conquerorEmpireProv.name;

  // 1. Tỉnh B chính thức chuyển quyền sở hữu sang cho Đế chế C
  tgtProv.ownerId = conquerorEmpireId;
  tgtProv.ownerName = conquerorEmpireName;
  tgtProv.color = conquerorEmpireProv.color; // Cùng màu với tỉnh đã chiếm đóng
  tgtProv.hp = 1000; // Khôi phục full máu 1000 HP

  // 2. Kiểm tra xem cựu chủ quyền (Đế chế A) còn tỉnh nào không
  // Một tỉnh chỉ bị tiêu diệt hoàn toàn khi mất toàn bộ lãnh thổ chính và mọi lãnh thổ chiếm được
  const remainingFormerLands = provinces.filter(p => (p.ownerId || p.id) === formerEmpireId);

  // 3. Hiển thị thông báo chi tiết
  showConquerBanner(conquerorEmpireProv, tgtProv, conquerorUser);

  let conquerMsg = '';
  if(formerEmpireId !== tgtProv.id){
    // Tỉnh C giành được tỉnh B từ tay tỉnh A
    conquerMsg = '🚩 [' + conquerorEmpireName + '] ĐÃ GIÀNH ĐƯỢC [' + tgtProv.name + '] TỪ TAY [' + formerEmpireName + ']!';
    addChat('HỆ THỐNG', '🚩 ' + conquerorEmpireName + ' đã đoạt ' + tgtProv.name + ' từ ' + formerEmpireName + '!');
  } else {
    // Tỉnh C đánh bại tỉnh gốc B
    conquerMsg = '🚩 [' + conquerorEmpireName + '] ĐÃ ĐÁNH BẠI VÀ THÔN TÍNH THÀNH CÔNG [' + tgtProv.name + ']!';
    addChat('HỆ THỐNG', '🚩 ' + conquerorEmpireName + ' đã chiếm trọn ' + tgtProv.name + '!');
  }
  addWarLog(conquerMsg, 'log-conquer');

  // Nếu tỉnh A mất sạch lãnh thổ => Báo tin tiêu diệt hoàn toàn & đọc số tỉnh còn lại
  if(remainingFormerLands.length === 0){
    const wipedMsg = '💀 [' + formerEmpireName + '] ĐÃ BỊ TIÊU DIỆT HOÀN TOÀN TRÊN BẢN ĐỒ!';
    addWarLog(wipedMsg, 'log-boss');
    addChat('HỆ THỐNG', '💀 ' + formerEmpireName + ' đã chính thức bị loại khỏi cuộc chiến!');
    const remainingCount = new Set(provinces.map(p => p.ownerId || p.id)).size;
    speakText(formerEmpireName + ' đã bị tiêu diệt hoàn toàn! Bản đồ hiện còn ' + remainingCount + ' tỉnh!');
  } else {
    // Âm thanh chiến thắng & Giọng đọc AI thông báo thôn tính
    playSoundEffect('conquer');
    const conquerPhrases = [
      conquerorEmpireName + ' đã chiếm ' + tgtProv.name + '!',
      conquerorEmpireName + ' vừa đánh bại và kiểm soát ' + tgtProv.name + '!',
      conquerorEmpireName + ' vừa mở rộng lãnh thổ, chiếm ' + tgtProv.name + '!'
    ];
    const phrase = conquerPhrases[Math.floor(Math.random() * conquerPhrases.length)];
    speakText(phrase);
  }

  // Pháo hoa ăn mừng tại tỉnh vừa chiếm
  if(tgtProv.center){
    const scr = geoToScreen(tgtProv.center[0], tgtProv.center[1]);
    for(let k = 0; k < 3; k++){
      setTimeout(function(){
        effects.push({ x: scr.x + (Math.random()-0.5)*20, y: scr.y + (Math.random()-0.5)*20, radius: 10, maxRadius: 55, color: tgtProv.color, alpha: 1.0 });
      }, k * 120);
    }
  }

  updateTargetDropdown();
  checkAndHealEnclaves();
  updateProvinceDropdownLabels();
  // Kiểm tra điều kiện đại thắng thống nhất toàn bộ 63 tỉnh thành
  checkUltimateVictory(conquerorEmpireProv);
}

const canvas = document.getElementById('battle-canvas');
const ctx    = canvas.getContext('2d');
const tooltip = document.getElementById('map-tooltip');

/* ----------------- CAMERA ZOOM & PAN 2D SYSTEM ----------------- */
const camera = {
  x: 0,
  y: 0,
  zoom: 1,
  minZoom: 1.0,  // Không cho thu nhỏ nhỏ hơn 1.0 để bản đồ luôn hiển thị trọn vẹn màn hình
  maxZoom: 4.5,
  isDragging: false,
  dragStartX: 0,
  dragStartY: 0,
  camStartX: 0,
  camStartY: 0
};

// Hàm giới hạn phạm vi dịch chuyển (Clamp Camera Pan Bounds):
// Không cho phép người dùng kéo bản đồ trôi ra ngoài màn hình.
function clampCamera(){
  // Biên độ di chuyển tối đa phụ thuộc vào mức zoom
  // Khi zoom = 1: bản đồ nằm ngay trung tâm (maxPan ~ 60px)
  // Khi zoom lớn: cho phép di chuyển trong phạm vi phần phóng to
  const maxPanX = Math.max(40, (canvas.width * (camera.zoom - 0.9)) / (2 * camera.zoom));
  const maxPanY = Math.max(50, (canvas.height * (camera.zoom - 0.9)) / (2 * camera.zoom));

  camera.x = Math.max(-maxPanX, Math.min(maxPanX, camera.x));
  camera.y = Math.max(-maxPanY, Math.min(maxPanY, camera.y));
}

// Khung kinh vĩ độ Việt Nam chuẩn đất liền
// Khung kinh vĩ độ Việt Nam đất liền chuẩn xác, giúp toàn bộ dải đất hình chữ S hiển thị to rõ, tràn ngập màn hình
const GEO_BOUNDS = {
  minLon: 102.14,
  maxLon: 109.50, // Bao trọn dải đất liền phía Đông
  minLat: 8.44,   // Mũi Cà Mau
  maxLat: 23.40   // Đỉnh Lũng Cú Hà Giang
};

// Dữ liệu 2 quần đảo Hoàng Sa & Trường Sa được hiển thị sắc nét ngoài biển Đông song hành cùng dải đất liền
// Dữ liệu chuẩn tọa độ địa lý quốc gia (WGS-84) của 2 quần đảo Hoàng Sa và Trường Sa
// Dữ liệu các chấm tròn biểu thị 2 quần đảo Hoàng Sa và Trường Sa gắn cố định vào tọa độ bản đồ
// Tọa độ gắn liền với không gian bản đồ thế giới, di chuyển và phóng to/thu nhỏ đồng bộ khi pan/zoom
const FIXED_ISLAND_DOTS = [
  // Cụm chấm Quần đảo Hoàng Sa (thuộc Đà Nẵng, nằm ngoài khơi miền Trung)
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 108.90, lat: 16.55, r: 3.8 },
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 109.15, lat: 16.85, r: 4.2 },
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 109.10, lat: 17.00, r: 3.2 },
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 108.75, lat: 16.20, r: 3.5 },
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 109.30, lat: 16.60, r: 3.5 },
  { provinceId: 'da_nang', name: 'Hoàng Sa', lon: 109.25, lat: 16.25, r: 3.2 },

  // Cụm chấm Quần đảo Trường Sa (thuộc Khánh Hòa, nằm ngoài khơi Nam Trung Bộ)
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 109.05, lat: 11.40, r: 3.8 },
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 109.20, lat: 10.95, r: 3.5 },
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 109.10, lat: 10.45, r: 4.2 },
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 108.85, lat: 9.80, r: 4.0 },
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 109.00, lat: 9.25, r: 3.5 },
  { provinceId: 'khanh_hoa', name: 'Trường Sa', lon: 109.25, lat: 9.50, r: 3.2 }
];

let baseScale = 1;
let baseOffsetX = 0;
let baseOffsetY = 0;

function updateBaseProjection(){
  const pad = 24;
  const availW = canvas.width - pad * 2;
  const availH = canvas.height - pad * 2;

  const geoW = (GEO_BOUNDS.maxLon - GEO_BOUNDS.minLon) * 1.02; // Co giãn nhẹ theo vĩ độ Việt Nam
  const geoH = (GEO_BOUNDS.maxLat - GEO_BOUNDS.minLat);

  // Mercator-like 2D projection scale
  const scaleX = availW / geoW;
  const scaleY = availH / geoH;
  baseScale = Math.min(scaleX, scaleY);

  const drawW = geoW * baseScale;
  const drawH = geoH * baseScale;

  baseOffsetX = (canvas.width - drawW) / 2 + pad/2;
  baseOffsetY = (canvas.height - drawH) / 2 + pad/2;
}

// Chuyển đổi Kinh độ/Vĩ độ (Lon, Lat) thành Tọa độ Màn hình (Canvas Screen X, Y)
function geoToScreen(lon, lat){
  const normX = (lon - GEO_BOUNDS.minLon) / (GEO_BOUNDS.maxLon - GEO_BOUNDS.minLon);
  const normY = (GEO_BOUNDS.maxLat - lat) / (GEO_BOUNDS.maxLat - GEO_BOUNDS.minLat);

  const worldX = baseOffsetX + normX * ((GEO_BOUNDS.maxLon - GEO_BOUNDS.minLon) * 1.02 * baseScale);
  const worldY = baseOffsetY + normY * ((GEO_BOUNDS.maxLat - GEO_BOUNDS.minLat) * baseScale);

  // Áp dụng Camera Zoom & Pan quanh tâm màn hình
  const cx = canvas.width / 2;
  const cy = canvas.height / 2;

  const screenX = cx + (worldX - cx + camera.x) * camera.zoom;
  const screenY = cy + (worldY - cy + camera.y) * camera.zoom;

  return { x: screenX, y: screenY };
}

// Chuyển đổi Tọa độ Màn hình về Tọa độ Thế giới
function screenToWorld(sx, sy){
  const cx = canvas.width / 2;
  const cy = canvas.height / 2;
  const wx = (sx - cx) / camera.zoom + cx - camera.x;
  const wy = (sy - cy) / camera.zoom + cy - camera.y;
  return { x: wx, y: wy };
}

function screenToGeo(sx, sy){
  const world = screenToWorld(sx, sy);
  const geoSpanX = (GEO_BOUNDS.maxLon - GEO_BOUNDS.minLon) * 1.02;
  const geoSpanY = GEO_BOUNDS.maxLat - GEO_BOUNDS.minLat;
  const normX = (world.x - baseOffsetX) / (geoSpanX * baseScale);
  const normY = (world.y - baseOffsetY) / (geoSpanY * baseScale);
  const lon = GEO_BOUNDS.minLon + normX * (GEO_BOUNDS.maxLon - GEO_BOUNDS.minLon);
  const lat = GEO_BOUNDS.maxLat - normY * geoSpanY;
  return { lon, lat };
}

function isPointInPolygon(px, py, ring){
  let inside = false;
  for(let i = 0, j = ring.length - 1; i < ring.length; j = i++){
    const xi = ring[i][0], yi = ring[i][1];
    const xj = ring[j][0], yj = ring[j][1];
    const intersect = ((yi > py) !== (yj > py)) && (px < (xj - xi) * (py - yi) / (yj - yi) + xi);
    if(intersect) inside = !inside;
  }
  return inside;
}

let hoveredProv = null;

function resizeCanvas(){
  canvas.width = canvas.clientWidth || canvas.parentElement.clientWidth;
  canvas.height = canvas.clientHeight || (canvas.parentElement.clientHeight - 90);
  updateBaseProjection();
}
window.addEventListener('resize', resizeCanvas);
resizeCanvas();

/* ---------------- TƯƠNG TÁC CHUỘT: PAN & ZOOM ---------------- */
function getProvinceAtScreenPos(sx, sy){
  // Kiểm tra trỏ chuột vào các chấm đảo cố định Hoàng Sa / Trường Sa
  for(const dot of FIXED_ISLAND_DOTS){
    const pos = geoToScreen(dot.lon, dot.lat);
    if(Math.hypot(pos.x - sx, pos.y - sy) <= Math.max(12, dot.r * camera.zoom + 6)){
      const prov = provinces.find(p => p.id === dot.provinceId);
      if(prov) return { ...prov, displayName: 'Quần đảo ' + dot.name + ' (' + prov.name + ')' };
    }
  }

  const geo = screenToGeo(sx, sy);
  for(const p of provinces){
    const rings = VN_PROVINCE_POLYGONS[p.id];
    if(rings){
      for(const ring of rings){
        if(ring.length >= 3 && isPointInPolygon(geo.lon, geo.lat, ring)){
          return p;
        }
      }
    }
  }
  let best = null;
  let minDist = 30 * Math.min(camera.zoom, 2.0);
  for(const p of provinces){
    if(p._cx && p._cy){
      const d = Math.hypot(p._cx - sx, p._cy - sy);
      if(d < minDist){
        minDist = d;
        best = p;
      }
    }
  }
  return best;
}

function zoomAt(factor, sx, sy){
  const cx = canvas.width / 2;
  const cy = canvas.height / 2;
  const newZoom = Math.min(camera.maxZoom, Math.max(camera.minZoom, camera.zoom * factor));
  if(newZoom === camera.zoom) return;

  // Giữ điểm tọa độ dưới con trỏ chuột cố định, không làm trôi bản đồ
  camera.x += (sx - cx) * (1 / newZoom - 1 / camera.zoom);
  camera.y += (sy - cy) * (1 / newZoom - 1 / camera.zoom);
  camera.zoom = newZoom;

  // Khóa bản đồ trong khung nhìn an toàn
  clampCamera();
}

canvas.addEventListener('wheel', (e) => {
  e.preventDefault();
  const zoomFactor = e.deltaY < 0 ? 1.15 : (1 / 1.15);
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left;
  const my = e.clientY - rect.top;
  zoomAt(zoomFactor, mx, my);
}, { passive: false });

canvas.addEventListener('mousedown', (e) => {
  if(e.button !== 0) return;
  camera.isDragging = true;
  camera.dragStartX = e.clientX;
  camera.dragStartY = e.clientY;
  camera.camStartX = camera.x;
  camera.camStartY = camera.y;
});

window.addEventListener('mousemove', (e) => {
  const rect = canvas.getBoundingClientRect();
  const mx = e.clientX - rect.left;
  const my = e.clientY - rect.top;

  if(!camera.isDragging) {
    if(mx >= 0 && mx <= canvas.width && my >= 0 && my <= canvas.height){
      hoveredProv = getProvinceAtScreenPos(mx, my);
      if(hoveredProv && tooltip){
        const isUnderOther = (hoveredProv.ownerName && hoveredProv.ownerId && hoveredProv.ownerId !== hoveredProv.id);
        const ownerTag = isUnderOther ? ' <span style="color:#f59e0b;font-size:10px;">[Thuộc: ' + hoveredProv.ownerName + ']</span>' : ' <span style="color:#10b981;font-size:10px;">[Độc lập]</span>';
        tooltip.innerHTML = '<strong>' + (hoveredProv.displayName || hoveredProv.name) + '</strong>' + ownerTag + '<br><span style="color:#38bdf8;">Quân lực: ' + Math.round(hoveredProv.hp !== undefined ? hoveredProv.hp : 1000) + ' / 1000 HP</span>';
        
        // Tự động tính toán vị trí tooltip để luôn nằm gọn trong khung bản đồ:
        // Nếu gần cạnh phải thì lật tooltip sang bên trái con trỏ chuột
        const tw = tooltip.offsetWidth || 160;
        const th = tooltip.offsetHeight || 50;
        let left = mx + 14;
        let top = my - 28;

        if (left + tw > canvas.width - 12) {
          left = mx - tw - 14;
        }
        if (left < 10) left = 10;

        // Nếu gần cạnh trên thì đẩy tooltip xuống dưới con trỏ chuột
        if (top < 10) {
          top = my + 20;
        } else if (top + th > canvas.height - 10) {
          top = canvas.height - th - 10;
        }

        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
        tooltip.style.opacity = '1';
      } else if(tooltip) {
        tooltip.style.opacity = '0';
      }
    } else {
      hoveredProv = null;
      if(tooltip) tooltip.style.opacity = '0';
    }
    return;
  }
  const dx = (e.clientX - camera.dragStartX) / camera.zoom;
  const dy = (e.clientY - camera.dragStartY) / camera.zoom;
  camera.x = camera.camStartX + dx;
  camera.y = camera.camStartY + dy;
  clampCamera(); // Khóa ranh giới kéo bản đồ
});

window.addEventListener('mouseup', () => {
  camera.isDragging = false;
});

canvas.addEventListener('mouseleave', () => {
  hoveredProv = null;
  if(tooltip) tooltip.style.opacity = '0';
});

// Nút zoom trên UI

// Mở khóa âm thanh trình duyệt ngay khi người dùng chạm chuột lần đầu
window.addEventListener('click', function unlockAllAudio(){
  initAudioContext();
  if(audioCtx && audioCtx.state === 'suspended'){
    audioCtx.resume();
  }
  loadVoices();
}, { once: false });

document.getElementById('btn-music-toggle')?.addEventListener('click', () => {
  toggleEpicBgm();
});

// Tự động kích hoạt nhạc nền khi người dùng tương tác bất kỳ lần đầu tiên
window.addEventListener('click', function autoStartMusicOnce(){
  if(!isMusicPlaying && audioCtx && audioCtx.state === 'running'){
    // nếu chưa bật thì có thể tự bật hoặc người dùng bấm nút
  }
}, { once: true });

document.getElementById('btn-audio-toggle')?.addEventListener('click', () => {
  isVoiceEnabled = !isVoiceEnabled;
  initAudioContext();
  const btn = document.getElementById('btn-audio-toggle');
  if(btn){
    btn.innerText = isVoiceEnabled ? '🔊' : '🔇';
    btn.title = isVoiceEnabled ? 'Đang BẬT Giọng đọc AI (Click để Tắt)' : 'Đang TẮT Giọng đọc AI (Click để Bật)';
  }
  if(!isVoiceEnabled && 'speechSynthesis' in window){
    window.speechSynthesis.cancel();
    speechQueue = [];
    isSpeaking = false;
  } else if(isVoiceEnabled){
    speakText('Đã bật giọng đọc AI bình luận viên chiến trường!', true);
  }
});

document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
  zoomAt(1.3, canvas.width / 2, canvas.height / 2);
});
document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
  zoomAt(1 / 1.3, canvas.width / 2, canvas.height / 2);
});
document.getElementById('btn-zoom-reset')?.addEventListener('click', () => {
  camera.zoom = 1;
  camera.x = 0;
  camera.y = 0;
});

/* ------------------------------------------------------------------ */
/*                     Game data & helpers                           */
/* ------------------------------------------------------------------ */
let units   = [];
let effects = [];
let totalCoins = 0;
let mvp = {name:'',coins:0};

/* WebSocket – nhận sự kiện từ server */
const ws = new WebSocket((location.protocol==='https:'?'wss:':'ws:')+'//'+location.host);
ws.onopen    = ()=> updateStats('WebSocket kết nối OK');
ws.onmessage = e=> { try{ const msg = JSON.parse(e.data);
                      if(msg.event==='action') handleAction(msg.data);
                    }catch(err){} };

/* --------------------------------------------------------------- */
// Danh sách đường kết nối hành quân (March Lines)
let marchLines = [];


/* ------------------------------------------------------------------ */
/*    HỆ THỐNG BÌNH LUẬN GIAO TRANH TÓM LƯỢC & ĐẠI CHIẾN CHUNG KẾT 2 TỈNH */
/* ------------------------------------------------------------------ */
let lastGeneralCommentTime = 0;
let lastAttackReportTime = 0;
let lastHpReportTime = 0;
let lastDuelAnnounceTime = 0;
let provinceAttackTimes = {};

function reportAttackStart(srcProv, tgtProv){
  const now = Date.now();
  const activeProvincesCount = window._lastActiveCount || 63;

  // Khi chỉ còn 2 hoặc 3 thế lực, nhịp độ bình luận được ưu tiên để tạo không khí chung kết kịch tính
  const attackCooldown = activeProvincesCount <= 3 ? 9000 : 13000;
  const generalCooldown = activeProvincesCount <= 3 ? 7000 : 9000;

  if(now - lastGeneralCommentTime < generalCooldown || now - lastAttackReportTime < attackCooldown) return;

  const pairKey = srcProv.id + '->' + tgtProv.id;
  const pairCooldown = activeProvincesCount <= 3 ? 15000 : 25000;
  if(provinceAttackTimes[pairKey] && (now - provinceAttackTimes[pairKey] < pairCooldown)) return;
  provinceAttackTimes[pairKey] = now;

  lastGeneralCommentTime = now;
  lastAttackReportTime = now;

  // Lấy tên chủ quyền cai quản thực sự
  const srcMasterName = srcProv.ownerName || srcProv.name;
  const tgtMasterName = tgtProv.ownerName || tgtProv.name;
  const srcName = srcProv.name;
  const tgtName = tgtProv.name;

  let attackPhrases = [];

  // NẾU CHỈ CÒN 2 THẾ LỰC TRỤ LẠI: Trận đại chiến sinh tử tranh bá toàn cõi!
  if(activeProvincesCount === 2){
    attackPhrases = [
      'Cuộc chiến diễn ra vô cùng ác liệt ở ' + tgtName + ' giữa ' + srcMasterName + ' và ' + tgtMasterName + '!',
      'Giao tranh nảy lửa ở ' + tgtName + '! ' + srcMasterName + ' đang dồn toàn lực tổng tấn công ' + tgtMasterName + '!',
      srcMasterName + ' quyết định dốc toàn bộ binh lực mở mũi đột kích vào phòng tuyến ' + tgtName + ' của ' + tgtMasterName + '!',
      'Trận đánh quyết định giang sơn! ' + srcMasterName + ' đang kịch chiến dữ dội với ' + tgtMasterName + ' tại ' + tgtName + '!',
      tgtMasterName + ' đang kiên cường chống đỡ đợt công kích như vũ bão của ' + srcMasterName + ' ở ' + tgtName + '!'
    ];
  } else if(activeProvincesCount <= 4){
    // Top 3-4 chung kết tranh bá
    attackPhrases = [
      'Chiến sự căng thẳng tại ' + tgtName + ' giữa ' + srcMasterName + ' và ' + tgtMasterName + '!',
      srcMasterName + ' bất ngờ mở chiến dịch đánh úp ' + tgtName + ' của ' + tgtMasterName + '!',
      'Giao tranh ác liệt tại vùng giáp ranh ' + tgtName + '! ' + srcMasterName + ' đang uy hiếp ' + tgtMasterName + '!'
    ];
  } else {
    // Giai đoạn đầu hoặc bình thường
    attackPhrases = [
      srcName + ' đã bắt đầu mở cuộc tấn công vào ' + tgtName + '!',
      'Chiến sự bùng nổ! ' + srcName + ' đang xua quân sang đánh ' + tgtName + '!',
      srcName + ' đã nổ súng tiến công biên giới ' + tgtName + '!'
    ];
  }

  const phrase = attackPhrases[Math.floor(Math.random() * attackPhrases.length)];
  speakText(phrase);
}

function reportHpStatus(tgtProv, currentHp){
  const now = Date.now();
  if(now - lastGeneralCommentTime < 11000 || now - lastHpReportTime < 15000) return;
  lastGeneralCommentTime = now;
  lastHpReportTime = now;

  const tgtName = tgtProv.name;
  const hpRounded = Math.round(currentHp);
  const activeCount = window._lastActiveCount || 63;

  if(currentHp <= 400 && currentHp > 0){
    const lowHpPhrases = activeCount === 2 ? [
      tgtName + ' phòng tuyến đang lung lay dữ dội, chỉ còn vỏn vẹn ' + hpRounded + ' máu!',
      tgtName + ' chịu tổn thất nặng nề, nguy cơ sụp đổ hoàn toàn trước đối thủ!',
      'Cảnh báo nguy cấp! Tuyến phòng ngự ' + tgtName + ' chỉ còn ' + hpRounded + ' máu!'
    ] : [
      tgtName + ' đang rất yếu máu, chỉ còn ' + hpRounded + ' máu!',
      tgtName + ' bị công kích dữ dội, máu đang giảm xuống mức nguy hiểm!',
      tgtName + ' phòng ngự suy yếu, máu tụt xuống chỉ còn ' + hpRounded + '!'
    ];
    speakText(lowHpPhrases[Math.floor(Math.random() * lowHpPhrases.length)]);
  } else if(currentHp > 400 && currentHp < 950){
    const normalHpPhrases = activeCount === 2 ? [
      tgtName + ' còn ' + hpRounded + ' máu sau đợt oanh tạc của đối phương!',
      tgtName + ' chịu tổn thất, hiện giữ ' + hpRounded + ' máu!'
    ] : [
      tgtName + ' còn ' + hpRounded + ' máu sau khi bị tấn công!',
      tgtName + ' trúng đòn công kích, còn lại ' + hpRounded + ' máu!'
    ];
    speakText(normalHpPhrases[Math.floor(Math.random() * normalHpPhrases.length)]);
  }
}

// Định kỳ kiểm tra tình hình bảo toàn lãnh thổ của các tỉnh
function reportTerritoryIntegrity(){
  const now = Date.now();
  if(now - lastGeneralCommentTime < 22000) return;

  const untouchedProvinces = provinces.filter(p => (p.hp === undefined || p.hp >= 1000) && (!p.ownerId || p.ownerId === p.id));
  if(untouchedProvinces.length > 0 && Math.random() < 0.6){
    lastGeneralCommentTime = now;
    const luckyProv = untouchedProvinces[Math.floor(Math.random() * untouchedProvinces.length)];
    const untouchedPhrases = [
      luckyProv.name + ' vẫn đang giữ vững toàn vẹn lãnh thổ!',
      luckyProv.name + ' phòng thủ kiên cố, chưa hề suy chuyển máu!',
      'Cục diện kiên cố! ' + luckyProv.name + ' vẫn bảo toàn nguyên vẹn lãnh thổ!'
    ];
    speakText(untouchedPhrases[Math.floor(Math.random() * untouchedPhrases.length)]);
  }
}
setInterval(reportTerritoryIntegrity, 22000);

function launchMarchTroops(srcProv, tgtProv, count = 4, userName = ''){
  if(!srcProv || !tgtProv || srcProv.id === tgtProv.id) return;
  // Tóm lược âm thanh bắt đầu tấn công khi chiến sự nổ ra
  reportAttackStart(srcProv, tgtProv);
  const sCenter = srcProv.center || [105.8, 21.0];
  const tCenter = tgtProv.center || [105.8, 21.0];

  // Thêm đường chỉ hướng kết nối giữa 2 tâm tỉnh
  marchLines.push({
    srcProv,
    tgtProv,
    color: srcProv.color,
    alpha: 1.0,
    created: Date.now()
  });

  // Mỗi lần tiến công xuất 1 chấm tròn chủ lực tương đương 50 HP (Nếu Quà Lớn Boss thì xuất 2 chấm = 100 HP)
  const troopDots = count >= 8 ? 2 : 1;
  for(let i = 0; i < troopDots; i++){
    setTimeout(() => {
      spawnMarchingTroop(srcProv, tgtProv, userName || srcProv.name);
    }, i * 140);
  }
}

function spawnMarchingTroop(srcProv, tgtProv, user){
  if(units.filter(u => u.isMarching).length > 35) return;
  const sCenter = srcProv.center || [105.8, 21.0];
  const tCenter = tgtProv.center || [105.8, 21.0];
  const startPos = geoToScreen(sCenter[0], sCenter[1]);

  const dist = Math.hypot(tCenter[0] - sCenter[0], tCenter[1] - sCenter[1]);
  const baseSpeed = 0.012;
  const dynamicSpeed = Math.max(baseSpeed, dist / 80);

  // Xác định Đế chế chủ quản của đạo quân này
  const empireId = srcProv.ownerId || srcProv.id;

  units.push({
    isMarching: true,
    empireId: empireId,
    provinceId: srcProv.id,
    targetProvId: tgtProv.id,
    user: user || srcProv.name,
    color: srcProv.color,
    lon: sCenter[0],
    lat: sCenter[1],
    targetLon: tCenter[0],
    targetLat: tCenter[1],
    x: startPos.x,
    y: startPos.y,
    radius: 4.8, // Chấm tròn quân lực rõ nét
    hp: 50, // MỖI 1 CHẤM TRÒN TƯƠNG ĐƯƠNG ĐÚNG 50 HP!
    maxHp: 50,
    speed: dynamicSpeed,
    attackDmg: 50 // Sát thương công thành chính xác 50 HP
  });
}

function handleAction(data){
  addChat(data.user, data.comment||'');
  const tgtProv = provinces.find(p=>p.id===data.provinceId) || provinces[0];
  const srcProv = provinces.find(p=>p.id===data.sourceProvinceId);

  if(srcProv && srcProv.id !== tgtProv.id){
    launchMarchTroops(srcProv, tgtProv, data.giftValue >= 50 ? 6 : 4, data.user);
  } else {
    if(data.type==='comment'){
      spawnUnit(tgtProv, data.user, 'soldier');
    }else if(data.type==='gift'){
      totalCoins += data.giftValue;
      if(data.giftValue>mvp.coins){
        mvp = {name:data.user,coins:data.giftValue};
        document.getElementById('mvp-banner').innerText = '👑 MVP: ' + mvp.name + ' (' + mvp.coins + ' xu)';
      }
      if(data.giftValue>=100){
        spawnUnit(tgtProv, data.user, 'boss');
        createShockwave(canvas.width/2, canvas.height/2, tgtProv.color);
      }else{
        spawnUnit(tgtProv, data.user, 'cavalry');
      }
    }
  }
  updateStats();
}

function provinceColor(p){ return p.color || regionColor(p.region); }
function regionColor(r){ return {bac:'#ff4d4f',trung:'#faad14',nam:'#13c2c2'}[r]; }

/* --------------------------------------------------------------- */
function spawnUnit(prov, user, type){
  const cfg = {
    soldier:{hp:30,spd:1.4,atk:1,r:6},
    cavalry:{hp:80,spd:2.2,atk:2,r:9},
    boss   :{hp:300,spd:0.9,atk:4,r:14}
  }[type];

  // Spawn tại tọa độ địa lý của tỉnh
  const c = prov.center || [105.8, 21.0];
  const screenPos = geoToScreen(c[0], c[1]);

  units.push({
    provinceId:prov.id,
    user,
    // Lưu tọa độ địa lý cố định để camera pan/zoom chính xác
    lon: c[0] + (Math.random() - 0.5) * 0.15,
    lat: c[1] + (Math.random() - 0.5) * 0.15,
    x: screenPos.x,
    y: screenPos.y,
    radius: cfg.r,
    hp: cfg.hp,
    maxHp: cfg.hp,
    speed: cfg.spd,
    attack: cfg.atk,
    type
  });
}

function createShockwave(x,y,color){
  // Hiệu ứng sóng chấn động gọn gàng quanh tâm, không lan rộng che khuất bản đồ
  effects.push({x,y,radius:6,maxRadius:36,color,alpha:0.9});
}

/* --------------------------------------------------------------- */
function addChat(user,msg){
  const c = document.getElementById('chat-stream');
  if(!c) return;
  const d = document.createElement('div');
  d.className = 'msg';
  d.innerHTML = '<span class="chat-name">' + user + ':</span> <span class="chat-text">' + msg + '</span>';
  c.appendChild(d);

  // Chỉ giữ tối đa 2 thông báo ngắn gọn để hoàn toàn KHÔNG che lấp bản đồ
  while(c.children.length > 2){
    c.removeChild(c.firstChild);
  }

  // Tự động mờ dần và giải phóng không gian sau 3.5 giây
  setTimeout(() => {
    if(d && d.parentNode){
      d.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      d.style.opacity = '0';
      d.style.transform = 'translateY(4px)';
      setTimeout(() => {
        if(d && d.parentNode) d.parentNode.removeChild(d);
      }, 400);
    }
  }, 3500);
}

/* --------------------------------------------------------------- */
function update(){
  // Cập nhật đường hành quân
  const now = Date.now();
  marchLines = marchLines.filter(m => (now - m.created) < 2500);
  for(const m of marchLines){
    m.alpha = Math.max(0, 1 - (now - m.created) / 2500);
  }

  // Di chuyển & giao tranh theo tọa độ địa lý
  for(let i=0;i<units.length;i++){
    const u = units[i];
    if(u.isMarching){
      // 1. CƠ CHẾ ĐỤNG ĐỘ TẠI ĐIỂM GIAO BIÊN GIỚI (MID-AIR CLASH):
      // Nếu quân tỉnh A đi sang B mà B cũng điều quân sang A (hoặc 2 chấm quân khác đế chế gặp nhau trên đường):
      // 2 đội quân sẽ đánh nhau trực tiếp tại điểm giao!
      let clashedTroop = null;
      let minClashDist = 1e9;

      for(let j = 0; j < units.length; j++){
        const v = units[j];
        if(!v.isMarching || v === u || v.hp <= 0) continue;

        // Chỉ giao chiến nếu thuộc 2 đế chế đối nghịch nhau
        const uEmpire = u.empireId || u.provinceId;
        const vEmpire = v.empireId || v.provinceId;
        if(uEmpire === vEmpire) continue;

        // Khoảng cách giữa 2 chấm quân trên bản đồ
        const d = Math.hypot(v.lon - u.lon, v.lat - u.lat);
        if(d < 0.22 && d < minClashDist){
          minClashDist = d;
          clashedTroop = v;
        }
      }

      if(clashedTroop){
        // GIAO TRANH TRỰC TIẾP TẠI ĐIỂM GIAO ĐƯỜNG QUÂN:
        const scrU = geoToScreen(u.lon, u.lat);
        const scrV = geoToScreen(clashedTroop.lon, clashedTroop.lat);
        const midX = (scrU.x + scrV.x) / 2;
        const midY = (scrU.y + scrV.y) / 2;

        // Hiệu ứng tia lửa va chạm chiến trận dữ dội
        effects.push({ x: midX, y: midY, radius: 5, maxRadius: 26, color: '#facc15', alpha: 1.0 });
        effects.push({ x: midX, y: midY, radius: 2, maxRadius: 18, color: '#ef4444', alpha: 0.9 });

        // Đọ điểm quân lực:
        const uHp = u.hp;
        const vHp = clashedTroop.hp;

        if(uHp > vHp){
          // Quân u nhiều điểm hơn: tiêu diệt hoàn toàn v, u còn phần máu chênh lệch và TIẾP TỤC TIẾN VÀO LÃNH THỔ B!
          u.hp -= vHp;
          u.attackDmg = u.hp; // Sát thương khi tới đích bằng đúng số máu còn lại
          clashedTroop.hp = 0;
          addWarLog('💥 Chạm trán biên giới: [' + (u.user || 'Quân đoàn') + '] đánh tan quân địch (' + Math.round(u.hp) + ' HP tiếp tục tiến công)!', 'log-boss');
        } else if(vHp > uHp){
          // Quân v nhiều điểm hơn: tiêu diệt hoàn toàn u, v tiếp tục tiến vào lãnh thổ A!
          clashedTroop.hp -= uHp;
          clashedTroop.attackDmg = clashedTroop.hp;
          u.hp = 0;
          addWarLog('💥 Chạm trán biên giới: [' + (clashedTroop.user || 'Quân đoàn') + '] bẻ gãy đợt công kích đối phương!', 'log-boss');
        } else {
          // NẾU CẢ 2 BẰNG NHAU (HOẶC CẢ 2 ĐỀU BỊ TIÊU DIỆT):
          // Huề nhau! Cả 2 cùng hy sinh tại điểm giao, KHÔNG BÊN NÀO MẤT MÁU LÃNH THỔ!
          u.hp = 0;
          clashedTroop.hp = 0;
          addWarLog('⚔️ Giao chiến giằng co: Hai đạo quân chạm trán và tiêu diệt lẫn nhau tại điểm giao, không bên nào mất máu lãnh thổ!', 'log-atk');
        }
        continue;
      }

      // 2. NẾU KHÔNG GẶP QUÂN ĐỊCH CẢN ĐƯỜNG: ĐÁNH THẲNG VÀO TÂM TỈNH ĐÍCH
      const dx = u.targetLon - u.lon;
      const dy = u.targetLat - u.lat;
      const dist = Math.hypot(dx, dy);

      if(dist < Math.max(0.12, u.speed * 1.5)){
        const tgt = provinces.find(p => p.id === u.targetProvId);
        const src = provinces.find(p => p.id === u.provinceId);
        if(tgt){
          const currentHp = (tgt.hp !== undefined ? tgt.hp : 1000);
          // ĐÁNH THẲNG VÀO: TỈNH ĐÍCH MẤT ĐÚNG 50 HP (hoặc theo số máu u.attackDmg của chấm quân)!
          const dmg = (u.attackDmg !== undefined ? u.attackDmg : 50);
          const newHp = currentHp - dmg;

          if(newHp <= 0){
            const srcEmpire = src ? (src.ownerId || src.id) : null;
            const tgtEmpire = tgt.ownerId || tgt.id;
            if(src && srcEmpire && srcEmpire !== tgtEmpire){
              onProvinceConquered(tgt, src, u.user);
            } else {
              tgt.hp = 0;
            }
          } else {
            tgt.hp = newHp;
            reportHpStatus(tgt, newHp);
          }
        }
        const hitScreen = geoToScreen(u.lon, u.lat);
        effects.push({ x: hitScreen.x, y: hitScreen.y, radius: 4, maxRadius: 22, color: u.color, alpha: 0.95 });
        u.hp = 0; // Chấm quân đã dồn trọn sát thương vào thành
      } else {
        const step = Math.min(dist, u.speed);
        u.lon += (dx / dist) * step;
        u.lat += (dy / dist) * step;
      }

      const scr = geoToScreen(u.lon, u.lat);
      u.x = scr.x;
      u.y = scr.y;
      continue;
    }
    let nearest=null, mind=1e9;
    for(const v of units){
      if(v===u) continue;
      if(v.type && u.type && v.type===u.type && v.provinceId===u.provinceId) continue;
      const d = Math.hypot(v.lon - u.lon, v.lat - u.lat);
      if(d < mind){ mind = d; nearest = v; }
    }
    if(nearest && mind < 1.5){
      const a = Math.atan2(nearest.lat - u.lat, nearest.lon - u.lon);
      u.lon += Math.cos(a) * (u.speed * 0.003);
      u.lat += Math.sin(a) * (u.speed * 0.003);
      if(mind < 0.2){
        nearest.hp -= u.attack;
        if(Math.random()<0.2){
          const p = geoToScreen(u.lon, u.lat);
          effects.push({x:p.x, y:p.y, radius:3, maxRadius:12, color:'#fff', alpha:1});
        }
      }
    }else{
      // Di chuyển tuần tra nhẹ quanh tỉnh
      const prov = provinces.find(p=>p.id===u.provinceId);
      if(prov && prov.center){
        const a = Math.atan2(prov.center[1] - u.lat, prov.center[0] - u.lon);
        u.lon += Math.cos(a) * (u.speed * 0.001);
        u.lat += Math.sin(a) * (u.speed * 0.001);
      }
    }
    // Cập nhật vị trí màn hình theo camera hiện tại
    const screenPos = geoToScreen(u.lon, u.lat);
    u.x = screenPos.x;
    u.y = screenPos.y;
  }

  // Loại bỏ đơn vị hy sinh
  units = units.filter(u=>{
    if(u.hp<=0){
      return false;
    }
    return true;
  });

  // Hiệu ứng sóng lan tinh gọn, tan biến nhanh chóng trong ~0.3s
  for(const e of effects){ e.radius += 2.5; e.alpha -= 0.08; }
  effects = effects.filter(e=>e.alpha>0 && e.radius < (e.maxRadius || 36));

  // Tự động kiểm tra và hồi phục các tỉnh được bao bọc an toàn trong hậu phương
  if(Math.random() < 0.15){
    checkAndHealEnclaves();
  }

  // Thanh máu 3 miền
  const regionHp = {bac:0,trung:0,nam:0};
  const regionMax = {bac:0,trung:0,nam:0};
  for(const p of provinces){
    const max = 1000;
    regionHp[p.region] += (p.hp||max);
    regionMax[p.region] += max;
  }
  for(const r in regionHp){
    const pct = Math.round(regionHp[r]/regionMax[r]*100);
    const bar = document.getElementById('hp-bar-'+r);
    const txt = document.getElementById('hp-txt-'+r);
    if(bar) bar.style.width = pct+'%';
    if(txt) txt.innerText = pct+'%';
  }
}

/* ----------------- HÀM VẼ HUY HIỆU BIỂN SỐ ----------------- */
function drawBadgeBox(ctx, x, y, width, height, radius) {
  ctx.beginPath();
  ctx.moveTo(x + radius, y);
  ctx.lineTo(x + width - radius, y);
  ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
  ctx.lineTo(x + width, y + height - radius);
  ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
  ctx.lineTo(x + radius, y + height);
  ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
  ctx.lineTo(x, y + radius);
  ctx.quadraticCurveTo(x, y, x + radius, y);
  ctx.closePath();
}

/* ------------------------------------------------------------------ */
/*                      RENDER VẼ BẢN ĐỒ 2D CHÍNH                     */
/* ------------------------------------------------------------------ */
function draw(){
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 1. NỀN HẢI HẢI ĐỒ 2D ĐẲNG CẤP & ĐƯỜNG KINH VĨ TUYẾN
  ctx.save();
  ctx.strokeStyle = 'rgba(56, 189, 248, 0.04)';
  ctx.lineWidth = 1;
  const gridStep = 40;
  for(let gx = 0; gx < canvas.width; gx += gridStep){
    ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, canvas.height); ctx.stroke();
  }
  for(let gy = 0; gy < canvas.height; gy += gridStep){
    ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(canvas.width, gy); ctx.stroke();
  }
  ctx.restore();

  // 2. VẼ 63 TỈNH THÀNH BẰNG ĐA GIÁC VECTOR 2D CHUẨN
  // TÍCH HỢP HIỆU ỨNG MỰC MÁU GIẢM DẦN TỪ TRÊN XUỐNG DƯỚI & NỔI LÊN KHI HOVER
  for(const p of provinces){
    const rings = VN_PROVINCE_POLYGONS[p.id];
    if(!rings || rings.length === 0) continue;

    const isHovered = (hoveredProv && hoveredProv.id === p.id);
    // Luôn lấy màu chuẩn xác nhất từ Đế chế cai trị (đồng nhất tuyệt đối)
    const empireMaster = (p.ownerId && p.ownerId !== p.id) ? provinces.find(pr => pr.id === p.ownerId) : null;
    const baseColor = empireMaster ? empireMaster.color : (p.color || '#334155');
    const isSafe = p.isEnclaveSafe || false;
    const hpRatio = isSafe ? 1.0 : Math.max(0, Math.min(1, (p.hp !== undefined ? p.hp : 1000) / 1000));

    // Lấy tọa độ màn hình đỉnh trên (topY) và đáy dưới (bottomY) của tỉnh
    const b = PROVINCE_BOUNDS[p.id];
    let topY, bottomY;
    if(b){
      topY = geoToScreen(b.minLon, b.maxLat).y;
      bottomY = geoToScreen(b.minLon, b.minLat).y;
    } else {
      topY = (p._cy || 300) - 40;
      bottomY = (p._cy || 300) + 40;
    }
    if(bottomY <= topY) bottomY = topY + 1;

    // Tạo Fill Style:
    // Nếu full máu hoặc là vùng hậu phương được bao vây an toàn => LẬP TỨC LẤP 100% FULL MÀU TƯƠI SÁNG ĐẾ CHẾ!
    let fillStyle;
    if(hpRatio >= 0.99 || isSafe){
      fillStyle = baseColor;
    } else if(hpRatio <= 0.01){
      fillStyle = '#0f172a';
    } else {
      const lostRatio = 1.0 - hpRatio;
      const grad = ctx.createLinearGradient(0, topY, 0, bottomY);
      grad.addColorStop(0, '#0f172a');
      grad.addColorStop(Math.max(0, lostRatio - 0.04), '#1e293b');
      grad.addColorStop(lostRatio, '#ef4444');
      grad.addColorStop(Math.min(1, lostRatio + 0.04), baseColor);
      grad.addColorStop(1, baseColor);
      fillStyle = grad;
    }

    ctx.save();
    if(isHovered){
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 18;
    }
    for(const ring of rings){
      if(ring.length < 3) continue;

      ctx.beginPath();
      const p0 = geoToScreen(ring[0][0], ring[0][1]);
      ctx.moveTo(p0.x, p0.y);
      for(let i = 1; i < ring.length; i++){
        const pt = geoToScreen(ring[i][0], ring[i][1]);
        ctx.lineTo(pt.x, pt.y);
      }
      ctx.closePath();

      if(isHovered){
        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.85;
        ctx.fill();
        ctx.fillStyle = fillStyle;
        ctx.globalAlpha = 0.9;
        ctx.fill();
        ctx.globalAlpha = 1.0;
      } else {
        ctx.fillStyle = fillStyle;
        ctx.fill();
      }

// Viền ranh giới tỉnh sắc nét (viền đậm rõ rệt phân định từng tỉnh kể cả khi cùng phe/cùng màu)
      if(isHovered){
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = Math.max(2.2, 2.8 * Math.min(camera.zoom, 2.0));
      } else if(hpRatio < 0.5){
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.85)';
        ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 1.8));
      } else {
        // Đường viền đen than đậm sắc nét chia tách rõ ranh giới các tỉnh liền kề
        ctx.strokeStyle = 'rgba(10, 15, 30, 0.95)';
        ctx.lineWidth = Math.max(0.9, 1.3 * Math.min(camera.zoom, 1.8));
      }
      ctx.stroke();
    }
    ctx.restore();
  }

  // 3. VẼ ĐƯỜNG BIÊN GIỚI QUỐC GIA & VIỀN BỜ BIỂN VIỆT NAM (NEON GLOW)
  ctx.save();
  ctx.shadowColor = 'rgba(56, 189, 248, 0.4)';
  ctx.shadowBlur = 10 * camera.zoom;
  ctx.strokeStyle = 'rgba(56, 189, 248, 0.55)';
  ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 2.0));

  for(const p of provinces){
    const rings = VN_PROVINCE_POLYGONS[p.id];
    if(!rings) continue;
    for(const ring of rings){
      if(ring.length < 3) continue;
      ctx.beginPath();
      const p0 = geoToScreen(ring[0][0], ring[0][1]);
      ctx.moveTo(p0.x, p0.y);
      for(let i = 1; i < ring.length; i++){
        const pt = geoToScreen(ring[i][0], ring[i][1]);
        ctx.lineTo(pt.x, pt.y);
      }
      ctx.closePath();
      ctx.stroke();
    }
  }
  ctx.restore();

  // 3.5. VẼ CÁC CHẤM BIỂU THỊ HOÀNG SA & TRƯỜNG SA (CỐ ĐỊNH TRÊN MAP, KHÔNG CÓ CHỮ)
  for(const dot of FIXED_ISLAND_DOTS){
    const pos = geoToScreen(dot.lon, dot.lat);
    const ownerProv = provinces.find(p => p.id === dot.provinceId) || { color: '#38bdf8' };
    const dotColor = ownerProv.color || '#38bdf8';
    const isHovered = (hoveredProv && hoveredProv.id === dot.provinceId);
    const r = Math.max(2.5, dot.r * Math.min(camera.zoom, 2.0));

    ctx.save();
    if(isHovered){
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 12;
    }

    // Vòng phát sáng nhẹ bên ngoài
    ctx.beginPath();
    ctx.arc(pos.x, pos.y, r + 2.0, 0, Math.PI * 2);
    ctx.fillStyle = isHovered ? 'rgba(56, 189, 248, 0.45)' : 'rgba(56, 189, 248, 0.2)';
    ctx.fill();

    // Chấm tròn biểu thị đảo (cố định trên map theo tọa độ địa lý)
    ctx.beginPath();
    ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);
    ctx.fillStyle = isHovered ? '#ffffff' : dotColor;
    ctx.fill();
    ctx.strokeStyle = isHovered ? '#38bdf8' : 'rgba(255, 255, 255, 0.75)';
    ctx.lineWidth = 1.0;
    ctx.stroke();

    ctx.restore();
  }

  // 4. VẼ BIỂN SỐ XE 2D GỌN GÀNG, THÔNG MINH THEO MỨC ZOOM
  // QUY TẮC RÕ RÀNG VÀ DỨT KHOÁT:
  // TỈNH BỊ CHIẾM (nằm dưới trướng tỉnh khác) => BỊ MẤT BIỂN SỐ HIỂN THỊ TRÊN MAP (KHÔNG VẼ GÌ CẢ)!
  // CHỈ CÓ THỦ PHỦ CHỦ QUYỀN (chưa bị chiếm) MỚI HIỂN THỊ BIỂN SỐ XE ĐẠI DIỆN ĐẾ CHẾ (như Hà Nội 30, Thanh Hóa 36...)!
  for(const p of provinces){
    if(!p.center) continue;
    const pos = geoToScreen(p.center[0], p.center[1]);
    p._cx = pos.x;
    p._cy = pos.y;

    // NẾU TỈNH ĐÃ BỊ CHIẾM => LẬP TỨC BỎ QUA, HOÀN TOÀN MẤT BIỂN SỐ TRÊN BẢN ĐỒ!
    if(p.ownerId && p.ownerId !== p.id){
      continue;
    }

    // Ẩn huy hiệu nếu nằm ngoài màn hình canvas
    if(pos.x < -30 || pos.x > canvas.width + 30 || pos.y < -30 || pos.y > canvas.height + 30) continue;

    const isHanoi = p.plate === '30';
    const isHCM = p.plate === '51';
    const isBig = isHanoi || isHCM;

    // Scale theo zoom vừa phải
    const scaleFactor = Math.min(1.4, Math.max(0.85, 0.75 + camera.zoom * 0.25));

    const bw = (isBig ? 24 : 20) * scaleFactor;
    const bh = (isBig ? 17 : 14) * scaleFactor;
    const rad = 4 * scaleFactor;
    const bx = pos.x - bw / 2;
    const by = pos.y - bh / 2;

    ctx.save();
    // TỈNH ĐỘC LẬP / THỦ PHỦ ĐẾ CHẾ:
    ctx.shadowColor = isHanoi ? '#ff3838' : (isHCM ? '#00e5ff' : (p.color || '#38bdf8'));
    ctx.shadowBlur = isBig ? 10 : 5;

    const bgGrad = ctx.createLinearGradient(bx, by, bx, by + bh);
    if(isHanoi){
      bgGrad.addColorStop(0, '#991b1b');
      bgGrad.addColorStop(1, '#450a0a');
    } else if(isHCM){
      bgGrad.addColorStop(0, '#0369a1');
      bgGrad.addColorStop(1, '#082f49');
    } else {
      bgGrad.addColorStop(0, 'rgba(15, 23, 42, 0.95)');
      bgGrad.addColorStop(1, 'rgba(2, 6, 23, 0.98)');
    }
    ctx.fillStyle = bgGrad;
    drawBadgeBox(ctx, bx, by, bw, bh, rad);
    ctx.fill();

    ctx.strokeStyle = isHanoi ? '#facc15' : (isHCM ? '#38bdf8' : 'rgba(255,255,255,0.7)');
    ctx.lineWidth = isBig ? 1.8 : 1.2;
    ctx.stroke();
    ctx.restore();

    ctx.save();
    ctx.fillStyle = isHanoi ? '#fef08a' : '#ffffff';
    const fontSize = Math.round((isBig ? 11 : 9.5) * scaleFactor);
    ctx.font = '900 ' + fontSize + 'px "Plus Jakarta Sans", sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(p.plate, pos.x, pos.y + 0.5);
    ctx.restore();
  }

  // 4.5. ĐƯỜNG KẾT NỐI HÀNH QUÂN TỪ TÂM TỈNH NGUỒN SANG TÂM TỈNH ĐÍCH
  for(const m of marchLines){
    if(!m.srcProv.center || !m.tgtProv.center) continue;
    const p1 = geoToScreen(m.srcProv.center[0], m.srcProv.center[1]);
    const p2 = geoToScreen(m.tgtProv.center[0], m.tgtProv.center[1]);

    ctx.save();
    ctx.strokeStyle = m.color;
    ctx.globalAlpha = m.alpha * 0.45; // Mờ nhẹ thanh lịch
    ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 1.5));
    ctx.setLineDash([4, 5]);
    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.stroke();

    // Điểm chỉ hướng nhẹ nhàng
    const midX = (p1.x + p2.x) / 2;
    const midY = (p1.y + p2.y) / 2;
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.arc(midX, midY, 2.2, 0, Math.PI * 2);
    ctx.fillStyle = m.color;
    ctx.fill();
    ctx.restore();
  }

  // 5. HIỆU ỨNG SÓNG CHẤN ĐỘNG & TIA SÁNG
  for(const e of effects){
    ctx.save();
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.radius * camera.zoom, 0, Math.PI*2);
    ctx.strokeStyle = e.color;
    ctx.globalAlpha = Math.max(0, e.alpha * 0.6);
    ctx.lineWidth = 1.2;
    ctx.stroke();
    ctx.restore();
  }

  // 6. CÁC ĐƠN VỊ CHIẾN ĐẤU (LÍNH, KỴ BINH, BOSS)
  for(const u of units){
    const prov = provinces.find(p=>p.id===u.provinceId) || provinces[0];
    const factionCol = provinceColor(prov);

    ctx.save();
    ctx.shadowColor = u.type==='boss' ? '#ef4444' : factionCol;
    ctx.shadowBlur = u.type==='boss' ? 16 : 8;

    const uRadius = u.radius * Math.min(1.4, Math.max(0.7, camera.zoom * 0.8));

    if(u.isMarching){
      // MỖI 1 CHẤM TRÒN TƯƠNG ĐƯƠNG 50 HP
      const r = Math.max(4.2, u.radius * Math.min(camera.zoom, 1.5));
      ctx.shadowColor = u.color;
      ctx.shadowBlur = 10;

      // Hào quang bảo vệ xung quanh chấm tròn
      ctx.beginPath();
      ctx.arc(u.x, u.y, r + 1.8, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.fill();

      // Thân chấm tròn mang màu cờ của phe xuất quân
      ctx.beginPath();
      ctx.arc(u.x, u.y, r, 0, Math.PI * 2);
      ctx.fillStyle = u.color;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.4;
      ctx.stroke();

      // Hiển thị số điểm 50 (hoặc số máu còn lại) phía trên chấm tròn
      ctx.save();
      ctx.fillStyle = '#fef08a';
      ctx.font = '800 8.5px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.9)';
      ctx.shadowBlur = 3;
      ctx.fillText(Math.round(u.hp), u.x, u.y - r - 2.5);
      ctx.restore();

      ctx.restore();
      continue;
    }

    ctx.beginPath();
    ctx.arc(u.x, u.y, uRadius, 0, Math.PI*2);
    const unitGrad = ctx.createRadialGradient(u.x - uRadius*0.3, u.y - uRadius*0.3, 1, u.x, u.y, uRadius);
    if(u.type==='boss'){
      unitGrad.addColorStop(0, '#fef08a');
      unitGrad.addColorStop(0.5, '#ef4444');
      unitGrad.addColorStop(1, '#7f1d1d');
    } else if(u.type==='cavalry'){
      unitGrad.addColorStop(0, '#ffffff');
      unitGrad.addColorStop(0.6, factionCol);
      unitGrad.addColorStop(1, '#0f172a');
    } else {
      unitGrad.addColorStop(0, '#ffffff');
      unitGrad.addColorStop(0.7, factionCol);
      unitGrad.addColorStop(1, '#1e293b');
    }
    ctx.fillStyle = unitGrad;
    ctx.fill();

    ctx.strokeStyle = u.type==='boss' ? '#fbbf24' : '#ffffff';
    ctx.lineWidth = u.type==='boss' ? 2.5 : 1.5;
    ctx.stroke();
    ctx.restore();

    // Mini thanh máu tinh gọn (chỉ hiển thị cho Boss hoặc khi zoom gần để tránh rối mắt)
    if(u.type === 'boss' || camera.zoom >= 1.6){
      const hpPct = Math.max(0, u.hp / (u.maxHp || 1));
      const hpBarW = Math.max(16, uRadius * 2.0);
      const hpBarH = 2.5;
      const hpBarX = u.x - hpBarW / 2;
      const hpBarY = u.y - uRadius - 5;

      ctx.fillStyle = 'rgba(15,23,42,0.8)';
      ctx.fillRect(hpBarX, hpBarY, hpBarW, hpBarH);
      ctx.fillStyle = hpPct > 0.5 ? '#10b981' : (hpPct > 0.25 ? '#f59e0b' : '#ef4444');
      ctx.fillRect(hpBarX, hpBarY, hpBarW * hpPct, hpBarH);

      if(u.type === 'boss'){
        ctx.fillStyle = '#fef08a';
        ctx.font = '800 9px "Plus Jakarta Sans", sans-serif';
        ctx.textAlign = 'center';
        ctx.shadowColor = 'rgba(0,0,0,0.9)';
        ctx.shadowBlur = 3;
        ctx.fillText('👑 ' + (u.user || 'BOSS'), u.x, hpBarY - 3);
      }
    }
  }

  

  // 8. ANIMATION CHUYỂN ĐỘNG ĐẶC TRƯNG CỦA TỈNH CHIẾN THẮNG (VICTORY PULSE & GOLDEN AURA)
  if(isVictoryTriggered && victoryProvince){
    const vElapsed = (Date.now() - victoryAnimationStartTime) / 1000;
    const vPulse = (Math.sin(vElapsed * 4) + 1) / 2; // 0 -> 1
    const vWave = (vElapsed * 90) % 200; // sóng lan tỏa
    const vCol = victoryProvince.color || '#facc15';

    ctx.save();
    // Vòng sóng vàng lan tỏa từ trung tâm tỉnh chiến thắng
    if(victoryProvince.center){
      const pCenter = geoToScreen(victoryProvince.center[0], victoryProvince.center[1]);
      ctx.beginPath();
      ctx.arc(pCenter.x, pCenter.y, 40 + vWave * 1.5, 0, Math.PI * 2);
      ctx.strokeStyle = vCol;
      ctx.lineWidth = 3;
      ctx.globalAlpha = Math.max(0, 1 - (vWave / 200));
      ctx.stroke();

      // Vương miện hoàng gia vàng rực rỡ trên thủ phủ
      ctx.font = '28px serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = '#facc15';
      ctx.shadowBlur = 18;
      ctx.fillText('👑', pCenter.x, pCenter.y - 28 - (vPulse * 6));
    }

    // Viền ánh hào quang toàn màn hình cho tỉnh chiến thắng
    ctx.globalAlpha = 0.15 + vPulse * 0.15;
    ctx.strokeStyle = vCol;
    ctx.lineWidth = 8;
    ctx.strokeRect(4, 4, canvas.width - 8, canvas.height - 8);
    ctx.restore();
  }

  requestAnimationFrame(()=>{ update(); draw(); });
}

draw();



