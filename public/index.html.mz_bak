document.getElementById('btn-audio-toggle')?.addEventListener('click', () => {
  isVoiceEnabled = !isVoiceEnabled;
  initAudioContext();
  const btn = document.getElementById('btn-audio-toggle');
  if(btn){
    btn.innerText = isVoiceEnabled ? '🔊' : '🔇';
    btn.title = isVoiceEnabled ? 'Đang BẬT Giọng đọc AI (Click để Tắt)' : 'Đang TẮT Giọng đọc AI (Click để Bật)';
  }
  if(!isVoiceEnabled && 'speechSynthesis' in window){
    window.speechSynthesis.cancel();
    speechQueue = [];
    isSpeaking = false;
  } else if(isVoiceEnabled){
    speakText('Đã bật giọng đọc AI bình luận viên chiến trường!', true);
  }
});

document.getElementById('btn-zoom-in')?.addEventListener('click', () => {
  zoomAt(1.45, canvas.width / 2, canvas.height / 2);
});
document.getElementById('btn-zoom-out')?.addEventListener('click', () => {
  zoomAt(1 / 1.45, canvas.width / 2, canvas.height / 2);
});
document.getElementById('btn-zoom-reset')?.addEventListener('click', () => {
  camera.zoom = 1;
  camera.x = 0;
  camera.y = 0;
  autoCam.active = false; autoCam.returning = false;
});

/* ------------------------------------------------------------------ */
/*                     Game data & helpers                           */
/* ------------------------------------------------------------------ */
let units   = [];
let effects = [];
let totalCoins = 0;
let mvp = {name:'',coins:0};

/* WebSocket – nhận sự kiện từ server */
const ws = new WebSocket((location.protocol==='https:'?'wss:':'ws:')+'//'+location.host);
ws.onopen    = ()=> updateStats('WebSocket kết nối OK');
ws.onmessage = e=> { try{ const msg = JSON.parse(e.data);
                      if(msg.event==='action') handleAction(msg.data);
                    }catch(err){} };

/* --------------------------------------------------------------- */
// Danh sách đường kết nối hành quân (March Lines)
let marchLines = [];


/* ------------------------------------------------------------------ */
/*    HỆ THỐNG BÌNH LUẬN GIAO TRANH TÓM LƯỢC & ĐẠI CHIẾN CHUNG KẾT 2 TỈNH */
/* ------------------------------------------------------------------ */
let lastGeneralCommentTime = 0;
let lastAttackReportTime = 0;
let lastHpReportTime = 0;
let lastDuelAnnounceTime = 0;
let provinceAttackTimes = {};

function reportAttackStart(srcProv, tgtProv){
  const now = Date.now();
  const activeProvincesCount = window._lastActiveCount || 63;

  // Khi chỉ còn 2 hoặc 3 thế lực, nhịp độ bình luận được ưu tiên để tạo không khí chung kết kịch tính
  const attackCooldown = activeProvincesCount <= 3 ? 5000 : 6500;
  const generalCooldown = activeProvincesCount <= 3 ? 4000 : 5000;

  if(now - lastGeneralCommentTime < generalCooldown || now - lastAttackReportTime < attackCooldown) return;

  const pairKey = srcProv.id + '->' + tgtProv.id;
  const pairCooldown = activeProvincesCount <= 3 ? 10000 : 12000;
  if(provinceAttackTimes[pairKey] && (now - provinceAttackTimes[pairKey] < pairCooldown)) return;
  provinceAttackTimes[pairKey] = now;

  lastGeneralCommentTime = now;
  lastAttackReportTime = now;

  // Lấy tên chủ quyền cai quản thực sự
  const srcMasterName = srcProv.ownerName || srcProv.name;
  const tgtMasterName = tgtProv.ownerName || tgtProv.name;
  const srcName = srcProv.name;
  const tgtName = tgtProv.name;

  let attackPhrases = [];

  // NẾU CHỈ CÒN 2 THẾ LỰC TRỤ LẠI: Trận đại chiến sinh tử tranh bá toàn cõi!
  if(activeProvincesCount === 2){
    attackPhrases = [
      'Cuộc chiến diễn ra vô cùng ác liệt ở ' + tgtName + ' giữa ' + srcMasterName + ' và ' + tgtMasterName + '!',
      'Giao tranh nảy lửa ở ' + tgtName + '! ' + srcMasterName + ' đang dồn toàn lực tổng tấn công ' + tgtMasterName + '!',
      srcMasterName + ' quyết định dốc toàn bộ binh lực mở mũi đột kích vào phòng tuyến ' + tgtName + ' của ' + tgtMasterName + '!',
      'Trận đánh quyết định giang sơn! ' + srcMasterName + ' đang kịch chiến dữ dội với ' + tgtMasterName + ' tại ' + tgtName + '!',
      tgtMasterName + ' đang kiên cường chống đỡ đợt công kích như vũ bão của ' + srcMasterName + ' ở ' + tgtName + '!'
    ];
  } else if(activeProvincesCount <= 4){
    // Top 3-4 chung kết tranh bá
    attackPhrases = [
      'Chiến sự căng thẳng tại ' + tgtName + ' giữa ' + srcMasterName + ' và ' + tgtMasterName + '!',
      srcMasterName + ' bất ngờ mở chiến dịch đánh úp ' + tgtName + ' của ' + tgtMasterName + '!',
      'Giao tranh ác liệt tại vùng giáp ranh ' + tgtName + '! ' + srcMasterName + ' đang uy hiếp ' + tgtMasterName + '!'
    ];
  } else {
    // Giai đoạn đầu hoặc bình thường
    attackPhrases = [
      srcName + ' đã bắt đầu mở cuộc tấn công vào ' + tgtName + '!',
      'Chiến sự bùng nổ! ' + srcName + ' đang xua quân sang đánh ' + tgtName + '!',
      srcName + ' đã nổ súng tiến công biên giới ' + tgtName + '!'
    ];
  }

  const phrase = attackPhrases[Math.floor(Math.random() * attackPhrases.length)];
  speakText(phrase);
  // Tự động zoom vừa phải ngẫu nhiên vào vùng giao tranh có giọng đọc
  triggerSmartAutoZoom(tgtProv, "attack");
}

function reportHpStatus(tgtProv, currentHp){
  const now = Date.now();
  if(now - lastGeneralCommentTime < 5000 || now - lastHpReportTime < 7500) return;
  lastGeneralCommentTime = now;
  lastHpReportTime = now;

  const tgtName = tgtProv.name;
  const hpRounded = Math.round(currentHp);
  const activeCount = window._lastActiveCount || 63;

  if(currentHp <= 400 && currentHp > 0){
    const lowHpPhrases = activeCount === 2 ? [
      tgtName + ' phòng tuyến đang lung lay dữ dội, chỉ còn vỏn vẹn ' + hpRounded + ' máu!',
      tgtName + ' chịu tổn thất nặng nề, nguy cơ sụp đổ hoàn toàn trước đối thủ!',
      'Cảnh báo nguy cấp! Tuyến phòng ngự ' + tgtName + ' chỉ còn ' + hpRounded + ' máu!'
    ] : [
      tgtName + ' đang rất yếu máu, chỉ còn ' + hpRounded + ' máu!',
      tgtName + ' bị công kích dữ dội, máu đang giảm xuống mức nguy hiểm!',
      tgtName + ' phòng ngự suy yếu, máu tụt xuống chỉ còn ' + hpRounded + '!'
    ];
    speakText(lowHpPhrases[Math.floor(Math.random() * lowHpPhrases.length)]);
    triggerSmartAutoZoom(tgtProv, "attack");
  } else if(currentHp > 400 && currentHp < 950){
    const normalHpPhrases = activeCount === 2 ? [
      tgtName + ' còn ' + hpRounded + ' máu sau đợt oanh tạc của đối phương!',
      tgtName + ' chịu tổn thất, hiện giữ ' + hpRounded + ' máu!'
    ] : [
      tgtName + ' còn ' + hpRounded + ' máu sau khi bị tấn công!',
      tgtName + ' trúng đòn công kích, còn lại ' + hpRounded + ' máu!'
    ];
    speakText(normalHpPhrases[Math.floor(Math.random() * normalHpPhrases.length)]);
  }
}

// Định kỳ kiểm tra tình hình bảo toàn lãnh thổ của các tỉnh
function reportTerritoryIntegrity(){
  const now = Date.now();
  if(now - lastGeneralCommentTime < 22000) return;

  const untouchedProvinces = provinces.filter(p => (p.hp === undefined || p.hp >= 1000) && (!p.ownerId || p.ownerId === p.id));
  if(untouchedProvinces.length > 0 && Math.random() < 0.6){
    lastGeneralCommentTime = now;
    const luckyProv = untouchedProvinces[Math.floor(Math.random() * untouchedProvinces.length)];
    const untouchedPhrases = [
      luckyProv.name + ' vẫn đang giữ vững toàn vẹn lãnh thổ!',
      luckyProv.name + ' phòng thủ kiên cố, chưa hề suy chuyển máu!',
      'Cục diện kiên cố! ' + luckyProv.name + ' vẫn bảo toàn nguyên vẹn lãnh thổ!'
    ];
    speakText(untouchedPhrases[Math.floor(Math.random() * untouchedPhrases.length)]);
  }
}
setInterval(reportTerritoryIntegrity, 22000);

function launchMarchTroops(srcProv, tgtProv, count = 4, userName = ''){
  if(!srcProv || !tgtProv || srcProv.id === tgtProv.id) return;
  // Tóm lược âm thanh bắt đầu tấn công khi chiến sự nổ ra
  reportAttackStart(srcProv, tgtProv);
  const sCenter = srcProv.center || [105.8, 21.0];
  const tCenter = tgtProv.center || [105.8, 21.0];

  // Thêm đường chỉ hướng kết nối giữa 2 tâm tỉnh
  marchLines.push({
    srcProv,
    tgtProv,
    color: srcProv.color,
    alpha: 1.0,
    created: Date.now()
  });

  // Mỗi lần tiến công xuất 1 chấm tròn chủ lực tương đương 50 HP (Nếu Quà Lớn Boss thì xuất 2 chấm = 100 HP)
  const troopDots = count >= 8 ? 2 : 1;
  for(let i = 0; i < troopDots; i++){
    setTimeout(() => {
      spawnMarchingTroop(srcProv, tgtProv, userName || srcProv.name);
    }, i * 140);
  }
}

function spawnMarchingTroop(srcProv, tgtProv, user){
  if(units.filter(u => u.isMarching).length > 45) return;
  const sCenter = srcProv.center || [105.8, 21.0];
  const tCenter = tgtProv.center || [105.8, 21.0];
  const startPos = geoToScreen(sCenter[0], sCenter[1]);

  const dist = Math.hypot(tCenter[0] - sCenter[0], tCenter[1] - sCenter[1]);
  // TĂNG TỐC KHI CHỈ CÒN 2 THẾ LỰC (SUDDEN DEATH)
  const speedMultiplier = window._isSuddenDeathActive ? 2.4 : 1.0;
  const baseSpeed = 0.015 * speedMultiplier;
  const dynamicSpeed = Math.max(baseSpeed, (dist / 70) * speedMultiplier);

  // Xác định Đế chế chủ quản của đạo quân này
  const empireId = getEmpireId(srcProv);
  const master = getEmpireMaster(srcProv);

  // Sát thương x2 khi ở chế độ Tử chiến Song hùng
  const dotHp = window._isSuddenDeathActive ? 300 : 150;

  units.push({
    isMarching: true,
    empireId: empireId,
    provinceId: srcProv.id,
    targetProvId: tgtProv.id,
    user: user || srcProv.name,
    color: master.color || srcProv.color,
    lon: sCenter[0],
    lat: sCenter[1],
    targetLon: tCenter[0],
    targetLat: tCenter[1],
    x: startPos.x,
    y: startPos.y,
    radius: window._isSuddenDeathActive ? 5.8 : 4.8,
    hp: dotHp,
    maxHp: dotHp,
    speed: dynamicSpeed,
    attackDmg: dotHp
  });
}

function handleAction(data){
  addChat(data.user, data.comment||'');
  const tgtProv = provinces.find(p=>p.id===data.provinceId) || provinces[0];
  const srcProv = provinces.find(p=>p.id===data.sourceProvinceId);

  if(srcProv && srcProv.id !== tgtProv.id){
    launchMarchTroops(srcProv, tgtProv, data.giftValue >= 50 ? 6 : 4, data.user);
  } else {
    if(data.type==='comment'){
      spawnUnit(tgtProv, data.user, 'soldier');
    }else if(data.type==='gift'){
      totalCoins += data.giftValue;
      if(data.giftValue>mvp.coins){
        mvp = {name:data.user,coins:data.giftValue};
        document.getElementById('mvp-banner').innerText = '👑 MVP: ' + mvp.name + ' (' + mvp.coins + ' xu)';
      }
      if(data.giftValue>=100){
        spawnUnit(tgtProv, data.user, 'boss');
        createShockwave(canvas.width/2, canvas.height/2, tgtProv.color);
      }else{
        spawnUnit(tgtProv, data.user, 'cavalry');
      }
    }
  }
  updateStats();
}

function provinceColor(p){ return p.color || regionColor(p.region); }
function regionColor(r){ return {bac:'#ff4d4f',trung:'#faad14',nam:'#13c2c2'}[r]; }

/* --------------------------------------------------------------- */
function spawnUnit(prov, user, type){
  const cfg = {
    soldier:{hp:30,spd:1.4,atk:1,r:6},
    cavalry:{hp:80,spd:2.2,atk:2,r:9},
    boss   :{hp:300,spd:0.9,atk:4,r:14}
  }[type];

  // Spawn tại tọa độ địa lý của tỉnh
  const c = prov.center || [105.8, 21.0];
  const screenPos = geoToScreen(c[0], c[1]);

  units.push({
    provinceId:prov.id,
    user,
    // Lưu tọa độ địa lý cố định để camera pan/zoom chính xác
    lon: c[0] + (Math.random() - 0.5) * 0.15,
    lat: c[1] + (Math.random() - 0.5) * 0.15,
    x: screenPos.x,
    y: screenPos.y,
    radius: cfg.r,
    hp: cfg.hp,
    maxHp: cfg.hp,
    speed: cfg.spd,
    attack: cfg.atk,
    type
  });
}

function createShockwave(x,y,color){
  // Hiệu ứng sóng chấn động gọn gàng quanh tâm, không lan rộng che khuất bản đồ
  effects.push({x,y,radius:6,maxRadius:36,color,alpha:0.9});
}

/* --------------------------------------------------------------- */
function addChat(user,msg){
  const c = document.getElementById('chat-stream');
  if(!c) return;
  const d = document.createElement('div');
  d.className = 'msg';
  d.innerHTML = '<span class="chat-name">' + user + ':</span> <span class="chat-text">' + msg + '</span>';
  c.appendChild(d);

  // Chỉ giữ tối đa 2 thông báo ngắn gọn để hoàn toàn KHÔNG che lấp bản đồ
  while(c.children.length > 2){
    c.removeChild(c.firstChild);
  }

  // Tự động mờ dần và giải phóng không gian sau 3.5 giây
  setTimeout(() => {
    if(d && d.parentNode){
      d.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
      d.style.opacity = '0';
      d.style.transform = 'translateY(4px)';
      setTimeout(() => {
        if(d && d.parentNode) d.parentNode.removeChild(d);
      }, 400);
    }
  }, 3500);
}

/* --------------------------------------------------------------- */
function update(){
  // Cập nhật camera tự động chuyển động mượt mà
  updateAutoCamera();

  // Cập nhật đường hành quân
  const now = Date.now();
  marchLines = marchLines.filter(m => (now - m.created) < 2500);
  for(const m of marchLines){
    m.alpha = Math.max(0, 1 - (now - m.created) / 2500);
  }

  // Di chuyển & giao tranh theo tọa độ địa lý
  for(let i=0;i<units.length;i++){
    const u = units[i];
    if(u.isMarching){
      // 1. CƠ CHẾ ĐỤNG ĐỘ TẠI ĐIỂM GIAO BIÊN GIỚI (MID-AIR CLASH):
      // Nếu quân tỉnh A đi sang B mà B cũng điều quân sang A (hoặc 2 chấm quân khác đế chế gặp nhau trên đường):
      // 2 đội quân sẽ đánh nhau trực tiếp tại điểm giao!
      let clashedTroop = null;
      let minClashDist = 1e9;

      for(let j = 0; j < units.length; j++){
        const v = units[j];
        if(!v.isMarching || v === u || v.hp <= 0) continue;

        // Chỉ giao chiến nếu thuộc 2 đế chế đối nghịch nhau
        const uEmpire = u.empireId || u.provinceId;
        const vEmpire = v.empireId || v.provinceId;
        if(uEmpire === vEmpire) continue;

        // Khoảng cách giữa 2 chấm quân trên bản đồ
        const d = Math.hypot(v.lon - u.lon, v.lat - u.lat);
        if(d < 0.22 && d < minClashDist){
          minClashDist = d;
          clashedTroop = v;
        }
      }

      if(clashedTroop){
        // GIAO TRANH TRỰC TIẾP TẠI ĐIỂM GIAO ĐƯỜNG QUÂN:
        const scrU = geoToScreen(u.lon, u.lat);
        const scrV = geoToScreen(clashedTroop.lon, clashedTroop.lat);
        const midX = (scrU.x + scrV.x) / 2;
        const midY = (scrU.y + scrV.y) / 2;

        // Hiệu ứng tia lửa va chạm chiến trận dữ dội
        effects.push({ x: midX, y: midY, radius: 5, maxRadius: 26, color: '#facc15', alpha: 1.0 });
        effects.push({ x: midX, y: midY, radius: 2, maxRadius: 18, color: '#ef4444', alpha: 0.9 });

        // Đọ điểm quân lực:
        const uHp = u.hp;
        const vHp = clashedTroop.hp;

        if(uHp > vHp){
          // Quân u nhiều điểm hơn: tiêu diệt hoàn toàn v, u còn phần máu chênh lệch và TIẾP TỤC TIẾN VÀO LÃNH THỔ B!
          u.hp -= vHp;
          u.attackDmg = u.hp; // Sát thương khi tới đích bằng đúng số máu còn lại
          clashedTroop.hp = 0;
          addWarLog('💥 Chạm trán biên giới: [' + (u.user || 'Quân đoàn') + '] đánh tan quân địch (' + Math.round(u.hp) + ' HP tiếp tục tiến công)!', 'log-boss');
        } else if(vHp > uHp){
          // Quân v nhiều điểm hơn: tiêu diệt hoàn toàn u, v tiếp tục tiến vào lãnh thổ A!
          clashedTroop.hp -= uHp;
          clashedTroop.attackDmg = clashedTroop.hp;
          u.hp = 0;
          addWarLog('💥 Chạm trán biên giới: [' + (clashedTroop.user || 'Quân đoàn') + '] bẻ gãy đợt công kích đối phương!', 'log-boss');
        } else {
          // NẾU CẢ 2 BẰNG NHAU (HOẶC CẢ 2 ĐỀU BỊ TIÊU DIỆT):
          // Huề nhau! Cả 2 cùng hy sinh tại điểm giao, KHÔNG BÊN NÀO MẤT MÁU LÃNH THỔ!
          u.hp = 0;
          clashedTroop.hp = 0;
          addWarLog('⚔️ Giao chiến giằng co: Hai đạo quân chạm trán và tiêu diệt lẫn nhau tại điểm giao, không bên nào mất máu lãnh thổ!', 'log-atk');
        }
        continue;
      }

      // 2. NẾU KHÔNG GẶP QUÂN ĐỊCH CẢN ĐƯỜNG: ĐÁNH THẲNG VÀO TÂM TỈNH ĐÍCH
      const dx = u.targetLon - u.lon;
      const dy = u.targetLat - u.lat;
      const dist = Math.hypot(dx, dy);

      if(dist < Math.max(0.12, u.speed * 1.5)){
        const tgt = provinces.find(p => p.id === u.targetProvId);
        const src = provinces.find(p => p.id === u.provinceId);
        if(tgt){
          const currentHp = (tgt.hp !== undefined ? tgt.hp : 1000);
          // ĐÁNH THẲNG VÀO: TỈNH ĐÍCH MẤT ĐÚNG 50 HP (hoặc theo số máu u.attackDmg của chấm quân)!
          const dmg = (u.attackDmg !== undefined ? u.attackDmg : 150);
          const newHp = currentHp - dmg;

          if(newHp <= 0){
            const srcEmpire = src ? (src.ownerId || src.id) : null;
            const tgtEmpire = tgt.ownerId || tgt.id;
            if(src && srcEmpire && srcEmpire !== tgtEmpire){
              onProvinceConquered(tgt, src, u.user);
            } else {
              tgt.hp = 0;
            }
          } else {
            tgt.hp = newHp;
            reportHpStatus(tgt, newHp);
          }
        }
        const hitScreen = geoToScreen(u.lon, u.lat);
        effects.push({ x: hitScreen.x, y: hitScreen.y, radius: 4, maxRadius: 22, color: u.color, alpha: 0.95 });
        u.hp = 0; // Chấm quân đã dồn trọn sát thương vào thành
      } else {
        const step = Math.min(dist, u.speed);
        u.lon += (dx / dist) * step;
        u.lat += (dy / dist) * step;
      }

      const scr = geoToScreen(u.lon, u.lat);
      u.x = scr.x;
      u.y = scr.y;
      continue;
    }
    let nearest=null, mind=1e9;
    for(const v of units){
      if(v===u) continue;
      if(v.type && u.type && v.type===u.type && v.provinceId===u.provinceId) continue;
      const d = Math.hypot(v.lon - u.lon, v.lat - u.lat);
      if(d < mind){ mind = d; nearest = v; }
    }
    if(nearest && mind < 1.5){
      const a = Math.atan2(nearest.lat - u.lat, nearest.lon - u.lon);
      u.lon += Math.cos(a) * (u.speed * 0.003);
      u.lat += Math.sin(a) * (u.speed * 0.003);
      if(mind < 0.2){
        nearest.hp -= u.attack;
        if(Math.random()<0.2){
          const p = geoToScreen(u.lon, u.lat);
          effects.push({x:p.x, y:p.y, radius:3, maxRadius:12, color:'#fff', alpha:1});
        }
      }
    }else{
      // Di chuyển tuần tra nhẹ quanh tỉnh
      const prov = provinces.find(p=>p.id===u.provinceId);
      if(prov && prov.center){
        const a = Math.atan2(prov.center[1] - u.lat, prov.center[0] - u.lon);
        u.lon += Math.cos(a) * (u.speed * 0.001);
        u.lat += Math.sin(a) * (u.speed * 0.001);
      }
    }
    // Cập nhật vị trí màn hình theo camera hiện tại
    const screenPos = geoToScreen(u.lon, u.lat);
    u.x = screenPos.x;
    u.y = screenPos.y;
  }

  // Loại bỏ đơn vị hy sinh
  units = units.filter(u=>{
    if(u.hp<=0){
      return false;
    }
    return true;
  });

  // Hiệu ứng sóng lan tinh gọn, tan biến nhanh chóng trong ~0.3s
  for(const e of effects){ e.radius += 2.5; e.alpha -= 0.08; }
  effects = effects.filter(e=>e.alpha>0 && e.radius < (e.maxRadius || 36));

  // Tự động kiểm tra và hồi phục các tỉnh được bao bọc an toàn trong hậu phương (chạy đều đặn mỗi frame)
  checkAndHealEnclaves();

  // Thanh máu 3 miền
  const regionHp = {bac:0,trung:0,nam:0};
  const regionMax = {bac:0,trung:0,nam:0};
  for(const p of provinces){
    const max = 1000;
    regionHp[p.region] += (p.hp||max);
    regionMax[p.region] += max;
  }
  for(const r in regionHp){
    const pct = Math.round(regionHp[r]/regionMax[r]*100);
    const bar = document.getElementById('hp-bar-'+r);
    const txt = document.getElementById('hp-txt-'+r);
    if(bar) bar.style.width = pct+'%';
    if(txt) txt.innerText = pct+'%';
  }
}

/* ----------------- HÀM VẼ HUY HIỆU BIỂN SỐ ----------------- */
function drawBadgeBox(ctx, x, y, width, height, radius) {
  ctx.beginPath();
  ctx.moveTo(x + radius, y);
  ctx.lineTo(x + width - radius, y);
  ctx.quadraticCurveTo(x + width, y, x + width, y + radius);
  ctx.lineTo(x + width, y + height - radius);
  ctx.quadraticCurveTo(x + width, y + height, x + width - radius, y + height);
  ctx.lineTo(x + radius, y + height);
  ctx.quadraticCurveTo(x, y + height, x, y + height - radius);
  ctx.lineTo(x, y + radius);
  ctx.quadraticCurveTo(x, y, x + radius, y);
  ctx.closePath();
}

/* ------------------------------------------------------------------ */
/*                      RENDER VẼ BẢN ĐỒ 2D CHÍNH                     */
/* ------------------------------------------------------------------ */
function draw(){
  ctx.clearRect(0, 0, canvas.width, canvas.height);

  // 1. NỀN HẢI HẢI ĐỒ 2D ĐẲNG CẤP & ĐƯỜNG KINH VĨ TUYẾN
  ctx.save();
  ctx.strokeStyle = 'rgba(56, 189, 248, 0.04)';
  ctx.lineWidth = 1;
  const gridStep = 40;
  for(let gx = 0; gx < canvas.width; gx += gridStep){
    ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, canvas.height); ctx.stroke();
  }
  for(let gy = 0; gy < canvas.height; gy += gridStep){
    ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(canvas.width, gy); ctx.stroke();
  }
  ctx.restore();

  // 1.5. Vẽ LÃNH TGỔ & ĐƯỜNG BIÀN GIỚI CÁC I_OUC GIÁP RANH (LL8O, CAMPUCHIA, TRUNG QUỐC) CÙNG CỜ MỜ
  if(typeof NEIGHBOR_COUNTRIES !== 'undefined'){
    ctx.save();
    for(const country of NEIGHBOR_COUNTRIES){
      ctx.fillStyle = country.fillColor || 'rgba(30, 41, 59, 0.45)';
      ctx.strokeStyle = country.strokeColor || 'rgba(148, 163, 184, 0.32)';
      ctx.lineWidth = Math.max(1.0, 1.3 * Math.min(camera.zoom, 1.6));
      ctx.setLineDash([4, 4]);

      for(const ring of country.polygons){
        if(!ring || ring.length < 3) continue;
        ctx.beginPath();
        const p0 = geoToScreen(ring[0][0], ring[0][1]);
        ctx.moveTo(p0.x, p0.y);
        for(let i = 1; i < ring.length; i++){
          const pt = geoToScreen(ring[i][0], ring[i][1]);
          ctx.lineTo(pt.x, pt.y);
        }
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }
      ctx.setLineDash([]);

      const bPos = geoToScreen(country.badgeLon, country.badgeLat);
      if(bPos.x > -150 && bPos.x < canvas.width + 150 && bPos.y > -150 && bPos.y < canvas.height + 150){
        ctx.save();
        ctx.translate(bPos.x, bPos.y);

        const flagW = Math.max(38, 48 * Math.min(camera.zoom, 1.8));
        const flagH = flagW * 0.62;
        const radius = 6;

        ctx.globalAlpha = 0.40;
        ctx.shadowColor = 'rgba(0,0,0,0.6)';
        ctx.shadowBlur = 8;
        ctx.fillStyle = 'rgba(15, 23, 42, 0.75)';
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.roundRect(-flagW/2, -flagH/2, flagW, flagH, radius);
        ctx.fill();
        ctx.stroke();

        ctx.save();
        ctx.beginPath();
        ctx.roundRect(-flagW/2, -flagH/2, flagW, flagH, radius);
        ctx.clip();

        if(country.flagType === 'laos'){
          ctx.fillStyle = '#ce1126';
          ctx.fillRect(-flagW/2, -flagH/2, flagW, flagH * 0.25);
          ctx.fillStyle = '#002868';
          ctx.fillRect(-flagW/2, -flagH/2 + flagH * 0.25, flagW, flagH * 0.5);
          ctx.fillStyle = '#ce1126';
          ctx.fillRect(-flagW/2, flagH/2 - flagH * 0.25, flagW, flagH * 0.25);
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(0, 0, flagH * 0.2, 0, Math.PI * 2);
          ctx.fill();
        } else if(country.flagType === 'cambodia'){
          ctx.fillStyle = '#032ea1';
          ctx.fillRect(-flagW/2, -flagH/2, flagW, flagH * 0.25);
          ctx.fillStyle = '#e00025';
          ctx.fillRect(-flagW/2, -flagH/2 + flagH * 0.25, flagW, flagH * 0.5);
          ctx.fillStyle = '#032ea1';
          ctx.fillRect(-flagW/2, flagH/2 - flagH * 0.25, flagW, flagH * 0.25);
          ctx.fillStyle = '#ffffff';
          const tw = flagW * 0.36;
          const th = flagH * 0.32;
          ctx.fillRect(-tw/2, -th/4, tw, th/2);
          ctx.fillRect(-tw/4, -th/2, tw/2, th/2);
          ctx.fillRect(-tw/8, -th * 0.65, tw/4, th * 0.65);
        } else if(country.flagType === 'china'){
          ctx.fillStyle = '#de2910';
          ctx.fillRect(-flagW/2, -flagH/2, flagW, flagH);
          ctx.fillStyle = '#ffde00';
          ctx.font = Math.round(flagH * 0.5) + 'px serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('★', -flagW * 0.22, -flagH * 0.12);
        }
        ctx.restore();

        ctx.globalAlpha = 0.75;
        ctx.shadowColor = '#000000';
        ctx.shadowBlur = 4;
        ctx.font = 'bold ' + Math.max(10, Math.round(11 * Math.min(camera.zoom, 1.4))) + 'px \'Chakra Petch\', sans-serif';
        ctx.fillStyle = '#cbd5e1';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText(country.name, 0, flagH/2 + 4);

        ctx.restore();
      }
    }
    ctx.restore();
  }
  // 2. VẼ 63 TỈNH THÀNH BẰNG ĐA GIÁC VECTOR 2D CHUẨN
  // TÍCH HỢP HIỆU ỨNG MỰC MÁU GIẢM DẦN TỪ TRÊN XUỐNG DƯỚI & NỔI LÊN KHI HOVER
  for(const p of provinces){
    const rings = VN_PROVINCE_POLYGONS[p.id];
    if(!rings || rings.length === 0) continue;

    const isHovered = (hoveredProv && hoveredProv.id === p.id);
    // Luôn lấy màu chuẩn xác nhất từ Đế chế cai trị tối cao (không bao giờ lệch màu trung gian)
    const empireMaster = getEmpireMaster(p);
    const baseColor = (empireMaster && empireMaster.color) ? empireMaster.color : (p.color || '#334155');
    const isSafe = p.isEnclaveSafe || false;
    const hpRatio = isSafe ? 1.0 : Math.max(0, Math.min(1, (p.hp !== undefined ? p.hp : 1000) / 1000));

    // Lấy tọa độ màn hình đỉnh trên (topY) và đáy dưới (bottomY) của tỉnh
    const b = PROVINCE_BOUNDS[p.id];
    let topY, bottomY;
    if(b){
      topY = geoToScreen(b.minLon, b.maxLat).y;
      bottomY = geoToScreen(b.minLon, b.minLat).y;
    } else {
      topY = (p._cy || 300) - 40;
      bottomY = (p._cy || 300) + 40;
    }
    if(bottomY <= topY) bottomY = topY + 1;

    // Tạo Fill Style:
    // Nếu full máu hoặc là vùng hậu phương được bao vây an toàn => LẬP TỨC LẤP 100% FULL MÀU TƯƠI SÁNG ĐẾ CHẾ!
    let fillStyle;
    if(hpRatio >= 0.99 || isSafe){
      fillStyle = baseColor;
    } else if(hpRatio <= 0.01){
      fillStyle = '#0f172a';
    } else {
      const lostRatio = 1.0 - hpRatio;
      const grad = ctx.createLinearGradient(0, topY, 0, bottomY);
      grad.addColorStop(0, '#0f172a');
      grad.addColorStop(Math.max(0, lostRatio - 0.04), '#1e293b');
      grad.addColorStop(lostRatio, '#ef4444');
      grad.addColorStop(Math.min(1, lostRatio + 0.04), baseColor);
      grad.addColorStop(1, baseColor);
      fillStyle = grad;
    }

    ctx.save();
    if(isHovered){
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 18;
    }
    for(const ring of rings){
      if(ring.length < 3) continue;

      ctx.beginPath();
      const p0 = geoToScreen(ring[0][0], ring[0][1]);
      ctx.moveTo(p0.x, p0.y);
      for(let i = 1; i < ring.length; i++){
        const pt = geoToScreen(ring[i][0], ring[i][1]);
        ctx.lineTo(pt.x, pt.y);
      }
      ctx.closePath();

      if(isHovered){
        ctx.fillStyle = '#ffffff';
        ctx.globalAlpha = 0.85;
        ctx.fill();
        ctx.fillStyle = fillStyle;
        ctx.globalAlpha = 0.9;
        ctx.fill();
        ctx.globalAlpha = 1.0;
      } else {
        ctx.fillStyle = fillStyle;
        ctx.fill();
      }

// Viền ranh giới tỉnh sắc nét (viền đậm rõ rệt phân định từng tỉnh kể cả khi cùng phe/cùng màu)
      if(isHovered){
        ctx.strokeStyle = '#38bdf8';
        ctx.lineWidth = Math.max(2.2, 2.8 * Math.min(camera.zoom, 2.0));
      } else if(hpRatio < 0.5){
        ctx.strokeStyle = 'rgba(239, 68, 68, 0.85)';
        ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 1.8));
      } else {
        // Đường viền đen than đậm sắc nét chia tách rõ ranh giới các tỉnh liền kề
        ctx.strokeStyle = 'rgba(10, 15, 30, 0.95)';
        ctx.lineWidth = Math.max(0.9, 1.3 * Math.min(camera.zoom, 1.8));
      }
      ctx.stroke();
    }
    ctx.restore();
  }

  // 3. VẼ ĐƯỜNG BIÊN GIỚI QUỐC GIA & VIỀN BỜ BIỂN VIỆT NAM (NEON GLOW)
  ctx.save();
  ctx.shadowColor = 'rgba(56, 189, 248, 0.4)';
  ctx.shadowBlur = 10 * camera.zoom;
  ctx.strokeStyle = 'rgba(56, 189, 248, 0.55)';
  ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 2.0));

  for(const p of provinces){
    const rings = VN_PROVINCE_POLYGONS[p.id];
    if(!rings) continue;
    for(const ring of rings){
      if(ring.length < 3) continue;
      ctx.beginPath();
      const p0 = geoToScreen(ring[0][0], ring[0][1]);
      ctx.moveTo(p0.x, p0.y);
      for(let i = 1; i < ring.length; i++){
        const pt = geoToScreen(ring[i][0], ring[i][1]);
        ctx.lineTo(pt.x, pt.y);
      }
      ctx.closePath();
      ctx.stroke();
    }
  }
  ctx.restore();

  // 3.5. VẼ CÁC CHẤM BIỂU THỊ HOÀNG SA & TRƯỜNG SA (CỐ ĐỊNH TRÊN MAP, KHÔNG CÓ CHỮ)
  for(const dot of FIXED_ISLAND_DOTS){
    const pos = geoToScreen(dot.lon, dot.lat);
    const ownerProv = provinces.find(p => p.id === dot.provinceId) || { color: '#38bdf8' };
    const dotColor = ownerProv.color || '#38bdf8';
    const isHovered = (hoveredProv && hoveredProv.id === dot.provinceId);
    const r = Math.max(2.5, dot.r * Math.min(camera.zoom, 2.0));

    ctx.save();
    if(isHovered){
      ctx.shadowColor = '#38bdf8';
      ctx.shadowBlur = 12;
    }

    // Vòng phát sáng nhẹ bên ngoài
    ctx.beginPath();
    ctx.arc(pos.x, pos.y, r + 2.0, 0, Math.PI * 2);
    ctx.fillStyle = isHovered ? 'rgba(56, 189, 248, 0.45)' : 'rgba(56, 189, 248, 0.2)';
    ctx.fill();

    // Chấm tròn biểu thị đảo (cố định trên map theo tọa độ địa lý)
    ctx.beginPath();
    ctx.arc(pos.x, pos.y, r, 0, Math.PI * 2);
    ctx.fillStyle = isHovered ? '#ffffff' : dotColor;
    ctx.fill();
    ctx.strokeStyle = isHovered ? '#38bdf8' : 'rgba(255, 255, 255, 0.75)';
    ctx.lineWidth = 1.0;
    ctx.stroke();

    ctx.restore();
  }

  // 4. VẼ BIỂN SỐ XE 2D GỌN GÀNG, THÔNG MINH THEO MỨC ZOOM
  // QUY TẮC RÕ RÀNG VÀ DỨT KHOÁT:
  // TỈNH BỊ CHIẾM (nằm dưới trướng tỉnh khác) => BỊ MẤT BIỂN SỐ HIỂN THỊ TRÊN MAP (KHÔNG VẼ GÌ CẢ)!
  // CHỈ CÓ THỦ PHỦ CHỦ QUYỀN (chưa bị chiếm) MỚI HIỂN THỊ BIỂN SỐ XE ĐẠI DIỆN ĐẾ CHẾ (như Hà Nội 30, Thanh Hóa 36...)!
  for(const p of provinces){
    if(!p.center) continue;
    const pos = geoToScreen(p.center[0], p.center[1]);
    p._cx = pos.x;
    p._cy = pos.y;

    // NẾU TỈNH ĐÃ BỊ CHIẾM (không phải thủ phủ đế chế hiện tại) => LẬP TỨC BỎ QUA, ẨN BIỂN SỐ!
    // Chỉ thủ phủ độc lập của đế chế (getEmpireId(p) === p.id) mới được giữ biển số xe!
    if(getEmpireId(p) !== p.id){
      continue;
    }

    // Ẩn huy hiệu nếu nằm ngoài màn hình canvas
    if(pos.x < -30 || pos.x > canvas.width + 30 || pos.y < -30 || pos.y > canvas.height + 30) continue;

    const isHanoi = p.plate === '30';
    const isHCM = p.plate === '51';
    const isBig = isHanoi || isHCM;

    // Scale theo zoom vừa phải
    const scaleFactor = Math.min(1.4, Math.max(0.85, 0.75 + camera.zoom * 0.25));

    const bw = (isBig ? 24 : 20) * scaleFactor;
    const bh = (isBig ? 17 : 14) * scaleFactor;
    const rad = 4 * scaleFactor;
    const bx = pos.x - bw / 2;
    const by = pos.y - bh / 2;

    ctx.save();
    // TỈNH ĐỘC LẬP / THỦ PHỦ ĐẾ CHẾ:
    ctx.shadowColor = isHanoi ? '#ff3838' : (isHCM ? '#00e5ff' : (p.color || '#38bdf8'));
    ctx.shadowBlur = isBig ? 10 : 5;

    const bgGrad = ctx.createLinearGradient(bx, by, bx, by + bh);
    if(isHanoi){
      bgGrad.addColorStop(0, '#991b1b');
      bgGrad.addColorStop(1, '#450a0a');
    } else if(isHCM){
      bgGrad.addColorStop(0, '#0369a1');
      bgGrad.addColorStop(1, '#082f49');
    } else {
      bgGrad.addColorStop(0, 'rgba(15, 23, 42, 0.95)');
      bgGrad.addColorStop(1, 'rgba(2, 6, 23, 0.98)');
    }
    ctx.fillStyle = bgGrad;
    drawBadgeBox(ctx, bx, by, bw, bh, rad);
    ctx.fill();

    ctx.strokeStyle = isHanoi ? '#facc15' : (isHCM ? '#38bdf8' : 'rgba(255,255,255,0.7)');
    ctx.lineWidth = isBig ? 1.8 : 1.2;
    ctx.stroke();
    ctx.restore();

    ctx.save();
    ctx.fillStyle = isHanoi ? '#fef08a' : '#ffffff';
    const fontSize = Math.round((isBig ? 11 : 9.5) * scaleFactor);
    ctx.font = '900 ' + fontSize + 'px "Plus Jakarta Sans", sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(p.carriedPlate || p.plate, pos.x, pos.y + 0.5);
    ctx.restore();
  }

  // 4.5. ĐƯỜNG KẾT NỐI HÀNH QUÂN TỪ TÂM TỈNH NGUỒN SANG TÂM TỈNH ĐÍCH
  for(const m of marchLines){
    if(!m.srcProv.center || !m.tgtProv.center) continue;
    const p1 = geoToScreen(m.srcProv.center[0], m.srcProv.center[1]);
    const p2 = geoToScreen(m.tgtProv.center[0], m.tgtProv.center[1]);

    ctx.save();
    ctx.strokeStyle = m.color;
    ctx.globalAlpha = m.alpha * 0.45; // Mờ nhẹ thanh lịch
    ctx.lineWidth = Math.max(1.0, 1.4 * Math.min(camera.zoom, 1.5));
    ctx.setLineDash([4, 5]);
    ctx.beginPath();
    ctx.moveTo(p1.x, p1.y);
    ctx.lineTo(p2.x, p2.y);
    ctx.stroke();

    // Điểm chỉ hướng nhẹ nhàng
    const midX = (p1.x + p2.x) / 2;
    const midY = (p1.y + p2.y) / 2;
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.arc(midX, midY, 2.2, 0, Math.PI * 2);
    ctx.fillStyle = m.color;
    ctx.fill();
    ctx.restore();
  }

  // 5. HIỆU ỨNG SÓNG CHẤN ĐỘNG & TIA SÁNG
  for(const e of effects){
    ctx.save();
    ctx.beginPath();
    ctx.arc(e.x, e.y, e.radius * camera.zoom, 0, Math.PI*2);
    ctx.strokeStyle = e.color;
    ctx.globalAlpha = Math.max(0, e.alpha * 0.6);
    ctx.lineWidth = 1.2;
    ctx.stroke();
    ctx.restore();
  }

  // 6. CÁC ĐƠN VỊ CHIẾN ĐẤU (LÍNH, KỴ BINH, BOSS)
  for(const u of units){
    const prov = provinces.find(p=>p.id===u.provinceId) || provinces[0];
    const factionCol = provinceColor(prov);

    ctx.save();
    ctx.shadowColor = u.type==='boss' ? '#ef4444' : factionCol;
    ctx.shadowBlur = u.type==='boss' ? 16 : 8;

    const uRadius = u.radius * Math.min(1.4, Math.max(0.7, camera.zoom * 0.8));

    if(u.isMarching){
      // MỖI 1 CHẤM TRÒN TƯƠNG ĐƯƠNG 50 HP
      const r = Math.max(4.2, u.radius * Math.min(camera.zoom, 1.5));
      ctx.shadowColor = u.color;
      ctx.shadowBlur = 10;

      // Hào quang bảo vệ xung quanh chấm tròn
      ctx.beginPath();
      ctx.arc(u.x, u.y, r + 1.8, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
      ctx.fill();

      // Thân chấm tròn mang màu cờ của phe xuất quân
      ctx.beginPath();
      ctx.arc(u.x, u.y, r, 0, Math.PI * 2);
      ctx.fillStyle = u.color;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.4;
      ctx.stroke();

      // Hiển thị số điểm 50 (hoặc số máu còn lại) phía trên chấm tròn
      ctx.save();
      ctx.fillStyle = '#fef08a';
      ctx.font = '800 8.5px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'center';
      ctx.shadowColor = 'rgba(0,0,0,0.9)';
      ctx.shadowBlur = 3;
      ctx.fillText(Math.round(u.hp), u.x, u.y - r - 2.5);
      ctx.restore();

      ctx.restore();
      continue;
    }

    ctx.beginPath();
    ctx.arc(u.x, u.y, uRadius, 0, Math.PI*2);
    const unitGrad = ctx.createRadialGradient(u.x - uRadius*0.3, u.y - uRadius*0.3, 1, u.x, u.y, uRadius);
    if(u.type==='boss'){
      unitGrad.addColorStop(0, '#fef08a');
      unitGrad.addColorStop(0.5, '#ef4444');
      unitGrad.addColorStop(1, '#7f1d1d');
    } else if(u.type==='cavalry'){
      unitGrad.addColorStop(0, '#ffffff');
      unitGrad.addColorStop(0.6, factionCol);
      unitGrad.addColorStop(1, '#0f172a');
    } else {
      unitGrad.addColorStop(0, '#ffffff');
      unitGrad.addColorStop(0.7, factionCol);
      unitGrad.addColorStop(1, '#1e293b');
    }
    ctx.fillStyle = unitGrad;
    ctx.fill();

    ctx.strokeStyle = u.type==='boss' ? '#fbbf24' : '#ffffff';
    ctx.lineWidth = u.type==='boss' ? 2.5 : 1.5;
    ctx.stroke();
    ctx.restore();

    // Mini thanh máu tinh gọn (chỉ hiển thị cho Boss hoặc khi zoom gần để tránh rối mắt)
    if(u.type === 'boss' || camera.zoom >= 1.6){
      const hpPct = Math.max(0, u.hp / (u.maxHp || 1));
      const hpBarW = Math.max(16, uRadius * 2.0);
      const hpBarH = 2.5;
      const hpBarX = u.x - hpBarW / 2;
      const hpBarY = u.y - uRadius - 5;

      ctx.fillStyle = 'rgba(15,23,42,0.8)';
      ctx.fillRect(hpBarX, hpBarY, hpBarW, hpBarH);
      ctx.fillStyle = hpPct > 0.5 ? '#10b981' : (hpPct > 0.25 ? '#f59e0b' : '#ef4444');
      ctx.fillRect(hpBarX, hpBarY, hpBarW * hpPct, hpBarH);

      if(u.type === 'boss'){
        ctx.fillStyle = '#fef08a';
        ctx.font = '800 9px "Plus Jakarta Sans", sans-serif';
        ctx.textAlign = 'center';
        ctx.shadowColor = 'rgba(0,0,0,0.9)';
        ctx.shadowBlur = 3;
        ctx.fillText('👑 ' + (u.user || 'BOSS'), u.x, hpBarY - 3);
      }
    }
  }

  

  // 8. ANIMATION CHUYỂN ĐỘNG ĐẶC TRƯNG CỦA TỈNH CHIẾN THẮNG (VICTORY PULSE & GOLDEN AURA)
  if(isVictoryTriggered && victoryProvince){
    const vElapsed = (Date.now() - victoryAnimationStartTime) / 1000;
    const vPulse = (Math.sin(vElapsed * 4) + 1) / 2; // 0 -> 1
    const vWave = (vElapsed * 90) % 200; // sóng lan tỏa
    const vCol = victoryProvince.color || '#facc15';

    ctx.save();
    // Vòng sóng vàng lan tỏa từ trung tâm tỉnh chiến thắng
    if(victoryProvince.center){
      const pCenter = geoToScreen(victoryProvince.center[0], victoryProvince.center[1]);
      ctx.beginPath();
      ctx.arc(pCenter.x, pCenter.y, 40 + vWave * 1.5, 0, Math.PI * 2);
      ctx.strokeStyle = vCol;
      ctx.lineWidth = 3;
      ctx.globalAlpha = Math.max(0, 1 - (vWave / 200));
      ctx.stroke();

      // Vương miện hoàng gia vàng rực rỡ trên thủ phủ
      ctx.font = '28px serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.shadowColor = '#facc15';
      ctx.shadowBlur = 18;
      ctx.fillText('👑', pCenter.x, pCenter.y - 28 - (vPulse * 6));
    }

    // Viền ánh hào quang toàn màn hình cho tỉnh chiến thắng
    ctx.globalAlpha = 0.15 + vPulse * 0.15;
    ctx.strokeStyle = vCol;
    ctx.lineWidth = 8;
    ctx.strokeRect(4, 4, canvas.width - 8, canvas.height - 8);
    ctx.restore();
  }

  requestAnimationFrame(()=>{ update(); draw(); });
}

draw();



/* ------------------------------------------------------------------ */
/*                         UI – Gửi hành động                         */
/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */

/* ------------------------------------------------------------------ */
/*          TÍNH NĂNG CHIẾN THUẬT RISK & COMMAND CENTER MỚI            */
/* ------------------------------------------------------------------ */

// Hàm lấy ID của Chủ quyền thực sự (Đế chế đang cai quản)
function getEmpireId(prov){
  if(!prov) return null;
  // Truy vết gốc rễ đến tận cùng để không bao giờ bị lồng trung gian (A -> B -> C => C)
  let cur = prov;
  let visited = new Set();
  while(cur && cur.ownerId && cur.ownerId !== cur.id && !visited.has(cur.id)){
    visited.add(cur.id);
    const parent = provinces.find(p => p.id === cur.ownerId);
    if(!parent) break;
    cur = parent;
  }
  return cur ? cur.id : prov.id;
}

function getEmpireMaster(prov){
  const empireId = getEmpireId(prov);
  return provinces.find(p => p.id === empireId) || prov;
}

// Lấy danh sách tất cả các tỉnh thuộc cùng 1 đế chế
function getEmpireProvinces(empireId){
  return provinces.filter(p => getEmpireId(p) === empireId);
}

// Hàm cập nhật nhãn Dropdown khi có biến động lãnh thổ
function updateProvinceDropdownLabels(){
  const src = document.getElementById('select-source-prov');
  if(!src) return;
  const currentVal = src.value;
  src.innerHTML = '';

  provinces.forEach(p => {
    const opt = document.createElement('option');
    opt.value = p.id;
    const isUnderEmpire = (p.ownerId && p.ownerId !== p.id);
    opt.textContent = p.name + ' (' + p.plate + ')' + (isUnderEmpire ? ' [Dưới trướng ' + p.ownerName + ']' : '');
    src.appendChild(opt);
  });

  if(currentVal && provinces.some(p => p.id === currentVal)){
    src.value = currentVal;
  } else {
    src.value = 'ha_noi';
  }
}

// 1. Khởi tạo danh sách tỉnh vào Dropdown
function initProvinceDropdowns(){
  updateProvinceDropdownLabels();
  updateTargetDropdown();
}

// 2. CẬP NHẬT MỤC TIÊU TẤN CÔNG: 
// - CHỈ CHO PHÉP TẤN CÔNG TỈNH GIÁP ĐƯỜNG BIÊN VỚI TOÀN BỘ LÃNH THỔ CỦA ĐẾ CHẾ
// - TUYỆT ĐỐI KHÔNG TỰ ĐÁNH ĐỒNG MINH / TỈNH CÙNG THUỘC MỘT PHE
function updateTargetDropdown(){
  const srcVal = document.getElementById('select-source-prov').value;
  const tgt = document.getElementById('select-target-prov');
  if(!tgt) return;
  tgt.innerHTML = '';
  
  const currentSrc = provinces.find(p => p.id === srcVal);
  if(!currentSrc) return;

  const empireId = getEmpireId(currentSrc);
  const myEmpireProvs = getEmpireProvinces(empireId);

  // Tập hợp tất cả các tỉnh tiếp giáp biên giới với bất kỳ tỉnh nào thuộc đế chế
  const validNeighborSet = new Set();
  myEmpireProvs.forEach(p => {
    const neighbors = VN_ADJACENCY[p.id] || [];
    neighbors.forEach(nid => {
      const neighborProv = provinces.find(pr => pr.id === nid);
      if(neighborProv && getEmpireId(neighborProv) !== empireId){
        validNeighborSet.add(nid);
      }
    });
  });

  const validNeighbors = Array.from(validNeighborSet);

  if(validNeighbors.length === 0){
    const opt = document.createElement('option');
    opt.value = '';
    opt.textContent = '👑 ĐÃ THỐNG NHẤT TOÀN DIỆN!';
    tgt.appendChild(opt);
    return;
  }

  validNeighbors.forEach(nid => {
    const p = provinces.find(pr => pr.id === nid);
    if(p){
      const opt = document.createElement('option');
      opt.value = p.id;
      const ownerLabel = (p.ownerId && p.ownerId !== p.id) ? ' (' + p.ownerName + ')' : '';
      opt.textContent = '⚔️ ' + p.name + ' [' + p.plate + ']' + ownerLabel;
      tgt.appendChild(opt);
    }
  });
}

// 3. Gửi lệnh công phá biên giới (Frontline Attack)
function sendFrontlineAttack(){
  const srcId = document.getElementById('select-source-prov').value;
  const tgtId = document.getElementById('select-target-prov').value;
  const user = document.getElementById('sim-user').value || 'Đại Tướng';
  
  const src = provinces.find(p => p.id === srcId);
  const tgt = provinces.find(p => p.id === tgtId);
  if(!src || !tgt) return;

  const empireId = getEmpireId(src);

  // Kiểm tra không được đánh quân phe mình
  if(getEmpireId(tgt) === empireId){
    alert('🚫 KHÔNG THỂ TẤN CÔNG!\n\nTỉnh ' + tgt.name + ' đã thuộc quyền kiểm soát của phe bạn!');
    return;
  }

  // Kiểm tra tính giáp ranh với toàn bộ đế chế
  const myEmpireProvs = getEmpireProvinces(empireId);
  let isBorderNeighbor = false;
  let launchingFromProv = src; // Chọn tỉnh giáp gần nhất để xuất phát quân

  for(const p of myEmpireProvs){
    const neighbors = VN_ADJACENCY[p.id] || [];
    if(neighbors.includes(tgt.id)){
      isBorderNeighbor = true;
      launchingFromProv = p; // Lính sẽ tràn qua từ chính tỉnh giáp biên này!
      break;
    }
  }

  if(!isBorderNeighbor){
    alert('🚫 VI PHẠM ĐƯỜNG BIÊN!\n\nTỉnh ' + tgt.name + ' không giáp ranh với bất kỳ tỉnh nào thuộc quyền kiểm soát của bạn.\nTheo luật RISK, bạn chỉ được đánh các tỉnh kề cận đường biên giới!');
    return;
  }

  addWarLog('⚔️ [' + src.name + '] mở chiến dịch tiến công biên giới [' + tgt.name + ']!', 'log-atk');

  // Mang danh nghĩa tỉnh đã chiếm mình
  const rulingEmpireName = src.ownerName || src.name;
  const marchUserName = (src.ownerName && src.ownerName !== src.name) 
    ? '[' + rulingEmpireName + ' - Binh đoàn ' + src.name + '] ' + user
    : '[' + rulingEmpireName + '] ' + user;

  fetch('/api/action', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      user: marchUserName,
      provinceId: tgt.id,
      sourceProvinceId: launchingFromProv.id,
      type: 'gift',
      giftValue: 20,
      comment: '⚔️ [' + rulingEmpireName + '] xuất quân công phá ' + tgt.name + '!'
    })
  }).catch(()=>{});
}

// 4. Nhật ký chiến sự (War Feed)
function addWarLog(text, className = ''){
  const box = document.getElementById('war-log-stream');
  if(!box) return;
  const time = new Date().toTimeString().substr(0, 8);
  const div = document.createElement('div');
  div.className = 'log-item ' + className;
  div.textContent = '[' + time + '] ' + text;
  box.prepend(div);
  if(box.children.length > 25) box.removeChild(box.lastChild);
}

// 5. CẬP NHẬT BẢNG XẾP HẠNG TOP TỈNH & HỆ THỐNG ENDGAME
function updateLeaderboard(){
  const tbody = document.getElementById('top-provinces-body');
  if(!tbody) return;

  // Gom nhóm thống kê theo từng Đế chế (Empire) qua getEmpireId
  const empires = {};

  provinces.forEach(p => {
    const empireId = getEmpireId(p);
    if(!empires[empireId]){
      const rootProv = provinces.find(pr => pr.id === empireId) || p;
      empires[empireId] = {
        id: empireId,
        name: rootProv.carriedName || rootProv.name,
        plate: rootProv.carriedPlate || rootProv.plate,
        color: rootProv.color,
        count: 0,
        totalHp: 0
      };
    }
    empires[empireId].count += 1;
    empires[empireId].totalHp += (p.hp !== undefined ? p.hp : 1000);
  });

  // Cập nhật số thế lực độc lập còn lại trên bản đồ
  const remainingActiveCount = Object.keys(empires).length;
  const remCountEl = document.getElementById('remaining-provinces-count');
  if(remCountEl){
    remCountEl.textContent = remainingActiveCount;
  }
  window._lastActiveCount = remainingActiveCount;

  // CƠ CHẾ SUDDEN DEATH: KHI CHỈ CÒN ĐÚNG 2 THẾ LỰC TRANH BÁ
  const sdEl = document.getElementById('sudden-death-banner');
  if(remainingActiveCount === 2){
    if(!window._isSuddenDeathActive){
      window._isSuddenDeathActive = true;
      if(sdEl) sdEl.classList.add('active');
      addWarLog('🔥 TỬ CHIẾN SONG HÙNG KÍCH HOẠT! Tốc độ x2.4 và Sát thương chấm quân x2 (300 HP)!', 'log-boss');
      playSoundEffect('conquer');
    }
  } else {
    window._isSuddenDeathActive = false;
    if(sdEl) sdEl.classList.remove('active');
  }

  const sortedEmpires = Object.values(empires).sort((a, b) => {
    if(b.count !== a.count) return b.count - a.count;
    return b.totalHp - a.totalHp;
  }).slice(0, 5);

  tbody.innerHTML = sortedEmpires.map((emp, idx) => {
    return '<tr><td class="rank-num">#' + (idx + 1) + '</td>' +
      '<td><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + emp.color + ';margin-right:6px;"></span><strong>' + emp.name + '</strong> (' + emp.plate + ')</td>' +
      '<td style="color:#38bdf8;font-family:sans-serif;font-weight:700;">' + emp.count + ' Tỉnh <span style="color:#facc15;font-size:11px;">(' + Math.round(emp.totalHp) + ' HP)</span></td></tr>';
  }).join('');

  // Giọng đọc AI bình luận cục diện (Đặc biệt kịch tính khi chỉ còn 2 tỉnh đấu sinh tử)
  if(sortedEmpires.length > 0){
    const topLeader = sortedEmpires[0];
    const nowTime = Date.now();
    const activeTotal = remainingActiveCount;

    if(activeTotal === 2 && sortedEmpires.length >= 2){
      if(nowTime - lastDuelAnnounceTime > 16000 && nowTime - lastGeneralCommentTime > 5000){
        lastDuelAnnounceTime = nowTime;
        lastGeneralCommentTime = nowTime;
        const emp1 = sortedEmpires[0];
        const emp2 = sortedEmpires[1];
        const duelPhrases = [
          'Trận chung kết đỉnh cao giữa ' + emp1.name + ' nắm giữ ' + emp1.count + ' tỉnh và ' + emp2.name + ' nắm giữ ' + emp2.count + ' tỉnh!',
          'Cục diện nghẹt thở! ' + emp1.name + ' và ' + emp2.name + ' đang tử chiến để định đoạt ai sẽ thống nhất toàn bộ Việt Nam!',
          'Ai sẽ là bá chủ 63 tỉnh thành? Cuộc đối đầu lịch sử giữa ' + emp1.name + ' và ' + emp2.name + ' đang diễn ra khốc liệt!'
        ];
        speakText(duelPhrases[Math.floor(Math.random() * duelPhrases.length)]);
      }
    } else {
      if(topLeader.id !== lastLeaderId && topLeader.count >= 2){
        lastLeaderId = topLeader.id;
        lastLeaderAnnounceTime = nowTime;
        speakText('Thông báo: ' + topLeader.name + ' đang dẫn đầu với ' + topLeader.count + ' tỉnh! Bản đồ hiện còn ' + activeTotal + ' thế lực!');
      } else if(nowTime - lastLeaderAnnounceTime > 25000 && topLeader.count >= 3){
        lastLeaderAnnounceTime = nowTime;
        speakText('Cục diện chiến trường: ' + topLeader.name + ' đang dẫn đầu với ' + topLeader.count + ' tỉnh! Bản đồ hiện còn ' + activeTotal + ' thế lực!');
      }
    }
  }
}
setInterval(updateLeaderboard, 1200);

// ==================================================================
// ĐỒNG HỒ ĐẾM NGƯỢC CHIẾN DỊCH 15 PHÚT (15:00 -> 00:00) & KẾT THÚC
// ==================================================================
let matchTimeRemaining = 15 * 60; // 15 phút = 900 giây
let matchTimerInterval = null;

function startMatchTimer(){
  if(matchTimerInterval) clearInterval(matchTimerInterval);
  matchTimerInterval = setInterval(() => {
    if(isVictoryTriggered) return;
    matchTimeRemaining--;
    if(matchTimeRemaining <= 0){
      matchTimeRemaining = 0;
      clearInterval(matchTimerInterval);
      onMatchTimeExpired();
    }
    updateMatchTimerDisplay();
  }, 1000);
}

function updateMatchTimerDisplay(){
  const clockEl = document.getElementById('match-timer-clock');
  const badgeEl = document.getElementById('match-timer-badge');
  if(!clockEl) return;
  const mins = Math.floor(matchTimeRemaining / 60);
  const secs = matchTimeRemaining % 60;
  clockEl.textContent = (mins < 10 ? '0' + mins : mins) + ':' + (secs < 10 ? '0' + secs : secs);

  if(matchTimeRemaining <= 120 && badgeEl){
    badgeEl.classList.add('urgent');
  } else if(badgeEl){
    badgeEl.classList.remove('urgent');
  }
}

// Khi hết 15 phút: Tính điểm tổng lực và tuyên bố Đế chế thắng cuộc
function onMatchTimeExpired(){
  addWarLog('⏱️ HẾT GIỜ 15 PHÚT! Trọng tài chiến trường tổng kết điểm số tối cao...', 'log-boss');
  speakText('Hết giờ chiến dịch 15 phút! Trọng tài đang tính điểm tổng lực để chọn ra Đế chế vô địch!', true);

  const empires = {};
  provinces.forEach(p => {
    const eid = getEmpireId(p);
    if(!empires[eid]){
      const rootProv = provinces.find(pr => pr.id === eid) || p;
      empires[eid] = { prov: rootProv, count: 0, totalHp: 0 };
    }
    empires[eid].count += 1;
    empires[eid].totalHp += (p.hp !== undefined ? p.hp : 1000);
  });

  const ranked = Object.values(empires).sort((a, b) => {
    const scoreA = (a.count * 1000) + a.totalHp;
    const scoreB = (b.count * 1000) + b.totalHp;
    return scoreB - scoreA;
  });

  if(ranked.length > 0){
    const winnerEmpire = ranked[0].prov;
    addWarLog('👑 THẾ LỰC CHIẾN THẮNG THEO ĐIỂM SỐ 15 PHÚT: [' + winnerEmpire.name + ']!', 'log-conquer');
    triggerVictory(winnerEmpire);
  }
}

// ==================================================================
// HÀM RESET VÁN ĐẤU MỚI (RESET 63 TỈNH VỀ TRẠNG THÁI GỐC)
// ==================================================================
function resetNewMatch(){
  if(!confirm('Bạn có chắc chắn muốn khởi tạo VÁN ĐẤU MỚI?\nToàn bộ bản đồ 63 tỉnh sẽ được khôi phục về trạng thái độc lập ban đầu (1000 HP).')) return;

  // Dừng auto nếu đang chạy
  if(autoTimer){
    clearInterval(autoTimer);
    autoTimer = null;
    const btn = document.getElementById('autoBtn');
    if(btn){
      btn.innerText = '⚡ KÍCH HOẠT AUTO-WAR (MÔ PHỎNG 63 TỈNH)';
      btn.style.background = '#059669';
    }
  }

  // Khôi phục thuộc tính 63 tỉnh
  if(window.INITIAL_PROVINCES && window.INITIAL_PROVINCES.length === 63){
    for(let i = 0; i < provinces.length; i++){
      const orig = window.INITIAL_PROVINCES[i];
      if(orig){
        provinces[i].ownerId = orig.id;
        provinces[i].ownerName = orig.name;
        provinces[i].color = orig.color;
        provinces[i].hp = 1000;
        provinces[i].isEnclaveSafe = false;
        delete provinces[i]._lastConqueredTime;
        delete provinces[i].carriedPlate;
      }
    }
  } else {
    provinces.forEach(p => {
      p.ownerId = p.id;
      p.ownerName = p.name;
      p.hp = 1000;
      p.isEnclaveSafe = false;
      delete p._lastConqueredTime;
    });
  }

  // Xóa sạch quân hành quân & hiệu ứng
  units.length = 0;
  effects.length = 0;
  marchLines.length = 0;

  // Đóng modal chiến thắng
  closeVictoryModal();
  isVictoryTriggered = false;
  victoryProvince = null;
  window._isSuddenDeathActive = false;
  const sdEl = document.getElementById('sudden-death-banner');
  if(sdEl) sdEl.classList.remove('active');

  // Đặt lại thời gian 15 phút
  matchTimeRemaining = 15 * 60;
  startMatchTimer();
  updateMatchTimerDisplay();

  // Cập nhật lại giao diện
  updateLeaderboard();
  updateProvinceDropdownLabels();
  updateTargetDropdown();

  addWarLog('🔄 ĐÃ KHỞI TẠO VÁN ĐẤU MỚI! 63 Tỉnh Thành sẵn sàng xuất kích!', 'log-boss');
  speakText('Ván đấu mới đã bắt đầu! 63 tỉnh thành bước vào cuộc chiến!', true);
}

startMatchTimer();

// 6. Đếm ngược giai đoạn (Turn Countdown)
let phaseSeconds = 45;
let currentPhaseIdx = 1;
const phases = [
  { name: '🛡️ GIAI ĐOẠN: TIẾP VIỆN', class: 'phase-reinforce' },
  { name: '⚔️ GIAI ĐOẠN: TẤN CÔNG', class: 'phase-attack' },
  { name: '🚩 GIAI ĐOẠN: CỦNG CỐ', class: 'phase-fortify' }
];

setInterval(() => {
  phaseSeconds--;
  if(phaseSeconds <= 0){
    phaseSeconds = 45;
    currentPhaseIdx = (currentPhaseIdx + 1) % phases.length;
    const badge = document.getElementById('current-phase-badge');
    if(badge){
      badge.textContent = phases[currentPhaseIdx].name;
      badge.className = 'phase-badge ' + phases[currentPhaseIdx].class;
      addWarLog('🔄 Chuyển sang ' + phases[currentPhaseIdx].name, 'log-boss');
    }
  }
  const timer = document.getElementById('phase-countdown');
  if(timer){
    const s = phaseSeconds < 10 ? '0' + phaseSeconds : phaseSeconds;
    timer.textContent = '00:' + s;
  }
}, 1000);

setTimeout(initProvinceDropdowns, 100);

/* ------------------------------------------------------------------ */
/*                         UI – Gửi hành động                         */
/* ------------------------------------------------------------------ */
function sendAction(mode){
  const user = document.getElementById('sim-user').value || 'Khán giả';
  const region = document.getElementById('sim-region').value;
  const list = provinces.filter(p=>p.region===region);
  const prov = list[Math.floor(Math.random()*list.length)];

  let payload = {user, provinceId:prov.id};

  if(mode==='comment'){
    payload.type='comment';
    payload.comment='Tiến lên '+prov.name+'!';
  }else if(mode==='gift_small'){
    payload.type='gift'; payload.giftValue=1; payload.comment='🌹 Tặng Hoa Hồng!';
  }else if(mode==='gift_big'){
    const tgtId = document.getElementById('select-target-prov').value;
    const srcId = document.getElementById('select-source-prov').value;
    const tgt = provinces.find(p=>p.id===tgtId) || prov;
    const src = provinces.find(p=>p.id===srcId) || prov;
    
    payload.provinceId = tgt.id;
    payload.sourceProvinceId = src.id;
    payload.type='gift';
    payload.giftValue=100;
    payload.comment='🚀 Đại Tướng oanh kích ' + tgt.name + '!';
    addWarLog('🚀 [' + (src.ownerName || src.name) + '] tung BOSS oanh tạc thẳng vào [' + tgt.name + ']!', 'log-boss');
  }

  fetch('/api/action',{method:'POST',
    headers:{'Content-Type':'application/json'},
    body:JSON.stringify(payload)}).catch(()=>{});
}

/* ------------------------------------------------------------------ */
/*                     Auto‑Bot – Tuân thủ 100% Luật RISK            */
/* ------------------------------------------------------------------ */
let autoTimer = null;
function toggleAuto(){
  console.log('[AUTO-WAR] toggleAuto clicked!');
  const btn = document.getElementById('autoBtn');
  
  // Bật nhạc nền hào khí an toàn (nếu có lỗi audio thì vẫn tiếp tục chạy game bình thường)
  try {
    if(typeof isMusicPlaying !== 'undefined' && !isMusicPlaying && typeof startEpicBgm === 'function'){
      startEpicBgm();
    }
  } catch(err) {
    console.warn('[AUDIO] Could not start BGM:', err);
  }

  if(autoTimer){
    clearInterval(autoTimer); 
    autoTimer = null;
    if(btn){
      btn.innerText = '⚡ KÍCH HOẠT AUTO-WAR (MÔ PHỎNG 63 TỈNH)'; 
      btn.style.background = '#059669';
    }
    addWarLog('🛑 Đã tạm dừng Auto-War.', 'log-atk');
  }else{
    if(btn){
      btn.innerText = '🛑 DỪNG AUTO-WAR'; 
      btn.style.background = '#ef4444';
    }
    let elapsed = 0;
    autoTimer = setInterval(()=>{
      // Can bang xuat phat ngau nhien deu giua 3 mien (Bac, Trung, Nam)
      const regions = ['bac', 'trung', 'nam'];
      const chosenRegion = regions[Math.floor(Math.random() * regions.length)];
      const regionProvs = provinces.filter(p => p.region === chosenRegion);
      const randomSrc = (regionProvs.length > 0 && Math.random() < 0.8)
        ? regionProvs[Math.floor(Math.random() * regionProvs.length)]
        : provinces[Math.floor(Math.random() * provinces.length)];
      const empireId = getEmpireId(randomSrc);

      // 2. Tim tat ca cac tinh giap ranh nhung KHAC DE CHE
      const allEmpireProvs = getEmpireProvinces(empireId);
      const enemyCandidates = [];

      for(const p of allEmpireProvs){
        const neighbors = VN_ADJACENCY[p.id] || [];
        for(const nid of neighbors){
          const nProv = provinces.find(pr => pr.id === nid);
          if(nProv && getEmpireId(nProv) !== empireId){
            enemyCandidates.push({ srcProv: p, tgtProv: nProv });
          }
        }
      }

      if(enemyCandidates.length === 0) return; // Đã thống nhất toàn diện hoặc không còn mục tiêu giáp ranh

      // Chọn 1 cặp giáp ranh hợp lệ
      const pair = enemyCandidates[Math.floor(Math.random() * enemyCandidates.length)];
      const isGift = Math.random() < 0.25;
      const big = isGift && Math.random() < 0.2;

      // Tỉnh kéo quân đi luôn mang danh của tỉnh đang cai trị mình
      const empireMasterName = pair.srcProv.ownerName || pair.srcProv.name;
      const autoMarchUser = (pair.srcProv.ownerName && pair.srcProv.ownerName !== pair.srcProv.name)
        ? '[' + empireMasterName + ' / Tiên phong ' + pair.srcProv.name + ']'
        : '[' + empireMasterName + ' Quân Đoàn]';

      const payload = {
        user: autoMarchUser,
        provinceId: pair.tgtProv.id,
        sourceProvinceId: pair.srcProv.id,
        type: isGift ? 'gift' : 'comment',
        giftValue: big ? 100 : (isGift ? 1 : 0),
        comment: isGift ? (big ? '🚀 Đại Tướng ' + empireMasterName + ' xuất kích!' : '🌹 Viện binh ' + empireMasterName) : ('⚔️ [' + empireMasterName + '] đột kích ' + pair.tgtProv.name)
      };

      fetch('/api/action',{method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify(payload)}).catch(()=>{});

      elapsed += 0.7;
      if(elapsed >= 120){
        clearInterval(autoTimer); autoTimer=null;
        btn.innerText='⚡ KÍCH HOẠT AUTO-WAR (MÔ PHỎNG 63 TỈNH)'; btn.style.background='#059669';
      }
    }, 700);
    addWarLog('⚡ Auto-War đã kích hoạt: Tuyệt đối tuân thủ đường biên kề & mở rộng lãnh thổ!', 'log-boss');
  }
}

function updateStats(custom){
  // Cập nhật ngầm
}
</script>
